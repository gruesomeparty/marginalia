<!doctype html>
<html lang="en"{{with .Theme.Palette}} data-palette="{{.}}"{{end}}{{with .Theme.Mode}} data-mode="{{.}}"{{end}}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Marginalia — inbox</title>
<script>
// Before first paint: the reviewer's display choice, as on the review page.
// Nothing else on this page needs a script; the filter form below only
// submits itself when a menu changes.
(function(){
  try{
    var mode = localStorage.getItem("marginalia.mode");
    if(mode === "light" || mode === "dark") document.documentElement.dataset.mode = mode;
    else if(mode === "system") delete document.documentElement.dataset.mode;
  }catch(e){}
})();
</script>
<style>
{{template "tokens.css"}}*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--sans);line-height:var(--lh-ui);font-size:var(--fs-base)}
header{position:sticky;top:0;z-index:10;background:var(--bg);border-bottom:1px solid var(--rule);padding:var(--sp-4) var(--sp-5);display:flex;align-items:center;flex-wrap:wrap;gap:var(--sp-3) var(--sp-5)}
header strong{font-size:var(--fs-lg)}
header .count{color:var(--muted)}
header .stats{margin-left:auto;color:var(--accent)}
header .stats:focus-visible{outline:none;box-shadow:var(--ring)}
main{max-width:68ch;margin:var(--sp-6) auto;padding:0 var(--sp-5)}
.tabs{display:flex;gap:var(--sp-2);margin:0 0 var(--sp-5);padding:0;list-style:none;flex-wrap:wrap}
.tabs a{display:inline-block;padding:var(--sp-2) var(--sp-4);border:1px solid var(--rule);border-radius:var(--r-pill);color:var(--fg);text-decoration:none}
.tabs a[aria-current="page"]{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
.tabs a:focus-visible{outline:none;box-shadow:var(--ring)}
.tabs .n{color:inherit;opacity:.75;margin-left:var(--sp-2)}
/* Filters live in the query string, so a filtered inbox is a link and the
   form works with no script; the one below only saves pressing Apply. */
.filters{display:flex;flex-wrap:wrap;align-items:center;gap:var(--sp-3) var(--sp-4);margin:0 0 var(--sp-6);font-size:var(--fs-sm);color:var(--muted)}
.filters label{display:inline-flex;align-items:center;gap:var(--sp-2)}
.filters .search{flex:1 1 100%}
.filters input,.filters select,.filters button{font:inherit;color:var(--fg);background:var(--card);border:1px solid var(--rule);border-radius:var(--r-pill);padding:var(--sp-2) var(--sp-4)}
.filters input{width:100%}
.filters button{cursor:pointer}
.filters input:focus-visible,.filters select:focus-visible,.filters button:focus-visible,.filters .clear:focus-visible{outline:none;box-shadow:var(--ring)}
.filters .clear{color:var(--accent)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.list{display:flex;flex-direction:column;gap:var(--sp-3);margin:0;padding:0;list-style:none}
.review{display:block;padding:var(--sp-4) var(--sp-5);background:var(--card);border:1px solid var(--rule);border-left:4px solid var(--rule);border-radius:var(--r-tab-lg);box-shadow:var(--shadow);color:inherit;text-decoration:none}
.review:hover{border-color:var(--accent)}
.review:focus-visible{outline:none;box-shadow:var(--ring)}
/* A row leads with what it needs from you (issue 134): status, then how many
   notes are outstanding, then anything wrong. Who sent it and which revision
   it is are there for when you go looking, so they come last and quieter. */
.group{margin:0 0 var(--sp-6)}
.group h2{font-size:var(--fs-sm);font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:0 0 var(--sp-3)}
.review .lead{display:flex;align-items:center;flex-wrap:wrap;gap:var(--sp-2) var(--sp-3);font-size:var(--fs-sm)}
.review .need{font-weight:600}
.review .warn{color:var(--bad)}
.review .when{margin-left:auto;color:var(--muted);font-size:var(--fs-xs);white-space:nowrap}
.review .title{display:block;margin-top:var(--sp-2);font-weight:600;font-size:var(--fs-md);min-width:0;overflow-wrap:anywhere}
.review .status{font-size:var(--fs-xs);font-weight:600;padding:var(--sp-1) var(--sp-3);border-radius:var(--r-pill);background:color-mix(in srgb,var(--accent) var(--tint-strong),transparent);color:var(--fg);white-space:nowrap}
.review.s-awaiting{border-left-color:var(--marker-ink)}
.review.s-awaiting .status{background:var(--marker);color:var(--on-marker)}
.review.s-in_progress{border-left-color:var(--accent)}
.review.s-replied{border-left-color:var(--accent)}
.review.s-replied .status{background:var(--accent);color:var(--on-accent)}
.review.s-done{border-left-color:var(--ok)}
.review.s-done .status{background:color-mix(in srgb,var(--ok) var(--tint-strong),transparent)}
.review .meta{display:flex;flex-wrap:wrap;gap:var(--sp-1) var(--sp-4);margin-top:var(--sp-1);color:var(--muted);font-size:var(--fs-xs)}
.empty{color:var(--muted);padding:var(--sp-6) 0;text-align:center}
@media (max-width:40rem){
  main{margin:var(--sp-5) auto;padding:0 var(--sp-4)}
}
@media (prefers-reduced-motion:no-preference){.review{transition:border-color .12s}}
</style>
</head>
<body>
<header>
  <strong>Marginalia</strong>
  <span class="count">{{.All}} review{{if ne .All 1}}s{{end}}</span>
  <a class="stats" href="/stats">Stats</a>
</header>
<main>
  <nav aria-label="Which reviews to show">
    <ul class="tabs">{{range .Tabs}}
      <li><a href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}<span class="n">{{.N}}</span></a></li>{{end}}
    </ul>
  </nav>
  <form class="filters" method="get" action="/" role="search" aria-label="Filter and group reviews">
    <input type="hidden" name="tab" value="{{.Tab}}">
    <label class="search"><span class="sr">Search</span><input type="search" name="q" value="{{.Filter.Query}}" placeholder="Search titles, agents, documents"></label>
    <label>Framing <select name="framing">{{range .Framings}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>
    <label>Agent <select name="agent">{{range .Agents}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>
    <label>Group by <select name="group">{{range .GroupBy}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>
    <button type="submit">Apply</button>
    {{if .Filtered}}<a class="clear" href="{{.Clear}}">Clear filters</a>{{end}}
  </form>
  {{if .Rows}}{{$grouped := .Grouped}}{{range .Groups}}
  <section class="group" aria-label="{{.Label}}">
    {{if $grouped}}<h2>{{.Label}}</h2>{{end}}
    <ul class="list">{{range .Rows}}
      <li><a class="review {{.Class}}" href="{{.URL}}" data-review="{{.ID}}" data-status="{{.Status}}">
        <span class="lead"><span class="status">{{.StatusLabel}}</span>
          {{- if .Outstanding}}<span class="need">{{.Outstanding}} outstanding</span>{{end}}
          {{- if .Stale}}<span class="warn">{{.Stale}} stale</span>{{end}}
          {{- if .Unclaimed}}<span class="warn">{{.Unclaimed}} unclaimed</span>{{end}}
          <time class="when" datetime="{{.WhenISO}}" title="last activity">{{.When}}</time></span>
        <span class="title">{{.Title}}</span>
        <span class="meta">
          {{if .Agent}}<span>from {{.Agent}}</span>{{end}}
          {{if .HasCounts}}<span>{{.Comments}} note{{if ne .Comments 1}}s{{end}}</span>{{end}}
          <span>published <time datetime="{{.SinceISO}}">{{.Since}}</time></span>
          <span>revision {{.Revision}}</span>
          <span>{{.Docs}} document{{if ne .Docs 1}}s{{end}}</span>
        </span>
      </a></li>{{end}}
    </ul>
  </section>{{end}}{{else}}<p class="empty">{{.Empty}}</p>{{end}}
</main>
<script>
(function(){
  var form = document.querySelector(".filters");
  if(!form) return;
  form.addEventListener("change", function(e){
    if(e.target.tagName === "SELECT") form.submit();
  });
})();
</script>
</body>
</html>
