<!doctype html>
<html lang="en"{{with .Theme.Palette}} data-palette="{{.}}"{{end}}{{with .Theme.Mode}} data-mode="{{.}}"{{end}}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Marginalia — {{.Doc.Path}}</title>
<script>
// Before first paint: the reviewer's own display choices, so a page served
// light does not flash white at someone who chose dark. Wrapped because
// storage throws in a private window, and a display preference is never
// worth an error.
(function(){
  try{
    var mode = localStorage.getItem("marginalia.mode");
    if(mode === "light" || mode === "dark") document.documentElement.dataset.mode = mode;
    else if(mode === "system") delete document.documentElement.dataset.mode;
    if(localStorage.getItem("marginalia.ligatures") === "off") document.documentElement.dataset.ligatures = "off";
  }catch(e){}
})();
</script>
<style>
/* The design language. Two layers, and the split is the rule: everything here
   is palette-invariant — type scale, spacing, radii, elevation, focus ring,
   accent tints — and a palette below may define colour tokens only. A palette
   that has to redefine a radius is a bug in the component, not in the palette.

   This exists because the stylesheet grew a rule at a time: eighteen distinct
   font sizes, ten radii, the same sans stack written out twelve times, and
   thirteen raw hexes outside the palette blocks. Adding a surface meant
   guessing which existing rule to imitate. */
:root{
  /* Type. --fs-base is the UI size everything else steps from. */
  --fs-2xs:.68rem;--fs-xs:.72rem;--fs-sm:.78rem;--fs-base:.85rem;--fs-md:.9rem;--fs-lg:1rem;
  --lh-tight:1.25;--lh-ui:1.5;--lh-body:1.6;
  --serif:Georgia,'Times New Roman',serif;
  --sans:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  /* Space. Six steps, which is what the thirty-two hand-picked paddings
     actually wanted to be. */
  --sp-1:.2rem;--sp-2:.35rem;--sp-3:.5rem;--sp-4:.75rem;--sp-5:1rem;--sp-6:1.5rem;
  /* Shape. --r-tab is the left-ruled card: square where the rule is. */
  --r-sm:4px;--r-md:6px;--r-lg:8px;--r-pill:999px;--r-round:50%;
  --r-tab:0 var(--r-md) var(--r-md) 0;--r-tab-lg:0 var(--r-lg) var(--r-lg) 0;
  /* Depth and focus. */
  --e-1:0 1px 3px rgba(0,0,0,.12);--e-2:0 2px 10px rgba(0,0,0,.18);
  --ring:0 0 0 2px var(--accent);
  /* Accent tints, named rather than spelled as percentages at each use. */
  --tint-weak:6%;--tint:7%;--tint-strong:12%;
}
/* A palette is a set of variables and light/dark is a mode, so the theme the
   agent served and the one the reviewer picked are the same mechanism. Order
   matters here: the palette blocks come after the default ones.

   Colour only. --on-accent and --on-marker are the text that goes *on* those
   fills, which is why they are palette-defined rather than assumed white. */
:root{--bg:#fbfbf9;--fg:#1a1a1a;--muted:#666;--rule:#e3e3dd;--accent:#3b5bdb;--marker:#e8b339;--card:#fff;--shadow:var(--e-1);--on-accent:#fff;--on-marker:#000;--ok:#2f7d32;--bad:#b3261e;--tok-kw:#a626a4;--tok-str:#3f7a3f;--tok-num:#8a5a00;--tok-com:#8a8a84}
:root[data-mode="dark"]{--bg:#1a1a1a;--fg:#e8e8e6;--muted:#9a9a94;--rule:#333;--accent:#8aa0ff;--marker:#d9a441;--card:#242424;--shadow:0 2px 10px rgba(0,0,0,.5);--on-accent:#12142a;--on-marker:#1a1a1a;--ok:#7bc47f;--bad:#f2857c;--tok-kw:#c792ea;--tok-str:#a5d6a7;--tok-num:#ffcb6b;--tok-com:#7f7f79}
@media (prefers-color-scheme:dark){:root:not([data-mode="light"]){--bg:#1a1a1a;--fg:#e8e8e6;--muted:#9a9a94;--rule:#333;--accent:#8aa0ff;--marker:#d9a441;--card:#242424;--shadow:0 2px 10px rgba(0,0,0,.5);--on-accent:#12142a;--on-marker:#1a1a1a;--ok:#7bc47f;--bad:#f2857c;--tok-kw:#c792ea;--tok-str:#a5d6a7;--tok-num:#ffcb6b;--tok-com:#7f7f79}}
/* Catppuccin Latte / Mocha, as a named option beside the default. */
:root[data-palette="catppuccin"]{--bg:#eff1f5;--fg:#4c4f69;--muted:#6c6f85;--rule:#ccd0da;--accent:#1e66f5;--marker:#df8e1d;--card:#e6e9ef;--shadow:0 1px 3px rgba(76,79,105,.14);--on-accent:#eff1f5;--on-marker:#4c4f69;--ok:#40a02b;--bad:#d20f39;--tok-kw:#8839ef;--tok-str:#40a02b;--tok-num:#fe640b;--tok-com:#9ca0b0}
:root[data-palette="catppuccin"][data-mode="dark"]{--bg:#1e1e2e;--fg:#cdd6f4;--muted:#a6adc8;--rule:#313244;--accent:#89b4fa;--marker:#f9e2af;--card:#181825;--shadow:0 2px 10px rgba(0,0,0,.5);--on-accent:#1e1e2e;--on-marker:#1e1e2e;--ok:#a6e3a1;--bad:#f38ba8;--tok-kw:#cba6f7;--tok-str:#a6e3a1;--tok-num:#fab387;--tok-com:#7f849c}
@media (prefers-color-scheme:dark){:root[data-palette="catppuccin"]:not([data-mode="light"]){--bg:#1e1e2e;--fg:#cdd6f4;--muted:#a6adc8;--rule:#313244;--accent:#89b4fa;--marker:#f9e2af;--card:#181825;--shadow:0 2px 10px rgba(0,0,0,.5);--on-accent:#1e1e2e;--on-marker:#1e1e2e;--ok:#a6e3a1;--bad:#f38ba8;--tok-kw:#cba6f7;--tok-str:#a6e3a1;--tok-num:#fab387;--tok-com:#7f849c}}
/* Mono stack: prefer a programming font the reviewer may already have — no
   webfont may be fetched — and ligate =>, != and -> where one is present. */
:root{--mono:"JetBrains Mono","Fira Code","Cascadia Code","Iosevka","Victor Mono","IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--serif);line-height:1.6}
header{position:sticky;top:0;z-index:10;background:var(--bg);border-bottom:1px solid var(--rule);padding:.6rem 1rem;display:flex;align-items:center;flex-wrap:wrap;gap:.6rem 1rem;font-family:var(--sans);font-size:var(--fs-base)}
header strong{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
header .count{color:var(--muted)}
header .where{color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
header .actions{margin-left:auto;display:flex;gap:.5rem;flex-shrink:0}
header button{font:inherit;padding:.4rem .9rem;border:1px solid var(--accent);background:var(--accent);color:var(--on-accent);border-radius:var(--r-md);cursor:pointer}
header button.secondary{background:transparent;color:var(--fg);border-color:var(--rule)}
/* Display settings: the reviewer's, not the agent's — theme and ligatures,
   remembered in this browser and nowhere else. The filter menu is the same
   popover, so it is the same rules rather than a second set that drifts. */
.display,.filter{position:relative;font-size:var(--fs-base)}
.display summary,.filter summary{list-style:none;cursor:pointer;padding:.4rem .9rem;border:1px solid var(--rule);border-radius:var(--r-md)}
.display summary::-webkit-details-marker,.filter summary::-webkit-details-marker{display:none}
.display[open] summary,.filter[open] summary{background:var(--card)}
.display .panel,.filter .panel{position:absolute;right:0;top:calc(100% + .35rem);z-index:20;background:var(--card);border:1px solid var(--rule);border-radius:var(--r-lg);box-shadow:var(--shadow);padding:.6rem;display:grid;gap:.5rem;min-width:13rem}
.display .group,.filter .group{display:flex;align-items:center;gap:.35rem;justify-content:space-between}
.display .group>span,.filter .group>span{color:var(--muted)}
.display .opts,.filter .opts{display:flex}
.display .opts button,.filter .opts button{font:inherit;font-size:var(--fs-sm);padding:.2rem .5rem;border:1px solid var(--rule);background:transparent;color:var(--fg);cursor:pointer;border-radius:0}
.display .opts button:first-child,.filter .opts button:first-child{border-radius:var(--r-md) 0 0 var(--r-md)}
.display .opts button:last-child,.filter .opts button:last-child{border-radius:var(--r-tab)}
.display .opts button+button,.filter .opts button+button{border-left:0}
.display .opts button[aria-pressed="true"],.filter .opts button[aria-pressed="true"]{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
/* Five filters do not fit a segmented row, so they stack. */
.filter .panel{min-width:12rem}
.filter .opts{flex-direction:column;width:100%}
.filter .opts button{border-radius:var(--r-tab);text-align:left}
.filter .opts button+button{border-left:1px solid var(--rule);margin-top:.2rem}
.filter .hint{color:var(--muted);font-size:var(--fs-xs);margin:0;max-width:16rem}
/* Progress: answered against commentable, which is the only ratio that means
   anything. A raw comment count says nothing about how much is left. */
.progress{display:flex;align-items:center;gap:.5rem;color:var(--muted);font-size:var(--fs-sm)}
.progress .bar{display:block;width:6rem;height:.4rem;background:var(--rule);border-radius:var(--r-pill);overflow:hidden}
.progress .fill{display:block;height:100%;width:0;background:var(--accent);border-radius:var(--r-pill);transition:width .2s ease}
.progress .of{white-space:nowrap}
@media (max-width:640px){.progress .bar{width:3rem}}
/* What Done is still waiting for, and the way to get there. Refusing the
   button without saying what is missing is how a reviewer learns the rule by
   being told no. */
.outstanding{margin:1rem auto;max-width:72ch;padding:.8rem 1rem;background:var(--card);border:1px solid var(--bad);border-radius:var(--r-lg);font-family:var(--sans);font-size:var(--fs-base)}
.outstanding h2{font-size:var(--fs-md);margin:0 0 .2rem}
.outstanding p{color:var(--muted);margin:0 0 .6rem}
.outstanding .list{display:flex;flex-direction:column;gap:.25rem;margin-bottom:.6rem;max-height:14rem;overflow:auto}
.outstanding .list button{font:inherit;font-size:var(--fs-sm);text-align:left;padding:.3rem .5rem;border:1px solid var(--rule);border-radius:var(--r-tab);background:transparent;color:var(--fg);cursor:pointer}
.outstanding .list button:hover{border-color:var(--accent);color:var(--accent)}
.outstanding .list .id{font-family:var(--mono);color:var(--muted);margin-right:.5rem}
.outstanding>button{font:inherit;padding:.3rem .8rem;border-radius:var(--r-md);cursor:pointer;border:1px solid var(--rule);background:transparent;color:var(--fg)}
/* A diff. The file line is the anchor a note about "this whole file" lands
   on; each hunk is its own block under it, which is how a reviewer talks
   about a change. Colour says added or removed and the marker column says it
   again, because a reviewer who cannot use the colour still has to read it. */
.diff-file{display:flex;align-items:baseline;gap:.5rem;flex-wrap:wrap;font-family:var(--mono)}
.diff-file .status{font-family:var(--sans);font-size:var(--fs-xs);text-transform:uppercase;letter-spacing:.04em;padding:0 .4rem;border-radius:var(--r-pill);border:1px solid var(--rule);color:var(--muted)}
.diff-file .status.added{color:var(--ok);border-color:var(--ok)}
.diff-file .status.deleted{color:var(--bad);border-color:var(--bad)}
.diff-file .status.renamed,.diff-file .status.binary{color:var(--accent);border-color:var(--accent)}
.diff-file .path{font-weight:600}
.diff-file .tally{font-family:var(--sans);font-size:var(--fs-sm)}
.diff-file .tally .plus{color:var(--ok)}
.diff-file .tally .minus{color:var(--bad)}
.diff-file .note{font-family:var(--sans);font-size:var(--fs-sm);color:var(--muted);font-style:italic}
.hunk .at{font-family:var(--mono);font-size:var(--fs-sm);color:var(--muted);padding:.1rem 0}
.hunk .lines{margin:0;padding:0;background:transparent;border:0;overflow-x:auto}
.hunk .ln{display:block;white-space:pre}
.hunk .ln .no{display:inline-block;width:3.5em;text-align:right;padding-right:.6em;color:var(--muted);opacity:.65;user-select:none}
.hunk .ln .mark{display:inline-block;width:1.2em;user-select:none}
.hunk .ln.add{background:color-mix(in srgb,var(--ok) var(--tint-weak),transparent)}
.hunk .ln.add .mark{color:var(--ok)}
.hunk .ln.del{background:color-mix(in srgb,var(--bad) var(--tint-weak),transparent)}
.hunk .ln.del .mark{color:var(--bad)}
.hunk .ln.eof{color:var(--muted);font-style:italic}
.patch-note{margin:0;white-space:pre-wrap;font-family:var(--mono);font-size:var(--fs-sm)}
/* A diff is wide, so it gets the room a prose document does not need. */
main.tree.diff{max-width:none}
/* A note about one sentence. The mark is the quote as it now reads — found
   again by the server, never an offset we hope still points somewhere. */
.block mark.mg-sub{background:color-mix(in srgb,var(--marker) var(--tint),transparent);color:inherit;border-radius:var(--r-tab);padding:0 .05em;box-shadow:0 1px 0 var(--marker)}
.block mark.mg-sub.on{background:color-mix(in srgb,var(--accent) var(--tint-strong),transparent);box-shadow:0 1px 0 var(--accent)}
.existing .item .quoted{margin:.2rem 0;padding-left:.5rem;border-left:2px solid var(--marker);color:var(--muted);font-style:italic}
/* The offer to comment on a selection, floating where the selection is. It is
   a button and not a hijacked mouseup, so selecting text to copy it stays
   exactly what it always was. */
.selbtn{position:absolute;z-index:30;font:inherit;font-family:var(--sans);font-size:var(--fs-sm);padding:.25rem .7rem;border:1px solid var(--accent);border-radius:var(--r-pill);background:var(--accent);color:var(--on-accent);cursor:pointer;box-shadow:var(--shadow);white-space:nowrap}
/* An inline block a filter would have hidden: it stays where the author put
   it and recedes, because removing a bullet renumbers the list around it. */
.block.dimmed{opacity:.35}
/* A block the reviewer jumped to, so the landing is visible rather than
   guessed at. */
.block.landed{animation:land 1.2s ease}
@keyframes land{from{background:color-mix(in srgb,var(--accent) var(--tint-strong),transparent)}to{background:transparent}}
@media (prefers-reduced-motion:reduce){.block.landed{animation:none;outline:2px solid var(--accent)}.progress .fill{transition:none}}
.layout{display:flex;align-items:flex-start}
main{flex:1;min-width:0;max-width:68ch;margin:2rem auto;padding:0 2.5rem}
.nav{position:sticky;top:2.9rem;flex:0 0 16rem;max-height:calc(100vh - 2.9rem);overflow:auto;padding:1.5rem .5rem 1.5rem 1.5rem;font-family:var(--sans);font-size:var(--fs-base);border-right:1px solid var(--rule)}
.nav summary{cursor:pointer;color:var(--muted);margin-bottom:.5rem}
.nav ul{list-style:none;margin:.15rem 0;padding-left:.85rem}
.nav>details>ul{padding-left:0}
.nav li{margin:.1rem 0}
.nav a{color:var(--fg);text-decoration:none;padding:.1rem .35rem;border-radius:var(--r-sm);display:inline-block;overflow-wrap:anywhere}
.nav a:hover{background:color-mix(in srgb,var(--accent) var(--tint-strong),transparent)}
.nav a[aria-current="page"]{background:var(--accent);color:var(--on-accent)}
.nav .dir{color:var(--muted)}
.nav .n{display:inline-block;min-width:1.15rem;height:1.15rem;line-height:1.15rem;text-align:center;background:var(--marker);color:var(--on-marker);border-radius:var(--r-pill);font-size:var(--fs-xs);margin-left:.3rem}
.nav .tick{margin-left:.3rem;color:var(--accent)}
/* A phone gets the buttons, not the breadcrumb: the nav already says which
   file is open, and a header that overflows scrolls the whole page sideways. */
@media (max-width:640px){header{gap:.5rem}header .where,header .count{display:none}header button{padding:.35rem .55rem}}
/* Stacked layout: a flex-start column shrink-wraps its children, so main
   would keep its 68ch reading width and scroll the whole page sideways on a
   phone. Both children take the width they are given instead. */
@media (max-width:900px){.layout{flex-direction:column}main{width:100%}.nav{position:static;flex:none;width:100%;max-height:none;padding:1rem 2.5rem 0;border-right:0;border-bottom:1px solid var(--rule)}}
h1,h2,h3,h4,h5,h6{font-family:var(--sans);line-height:1.25}
code,pre{font-family:var(--mono);font-variant-ligatures:contextual;font-feature-settings:"calt" 1}
/* Ligatures are opt-outable: they can hide a real `!`, and some readers
   simply dislike them. */
:root[data-ligatures="off"] code,:root[data-ligatures="off"] pre{font-variant-ligatures:none;font-feature-settings:"calt" 0}
.tok.kw{color:var(--tok-kw)}
.tok.str{color:var(--tok-str)}
.tok.num{color:var(--tok-num)}
.tok.com{color:var(--tok-com);font-style:italic}
pre{background:var(--card);padding:1rem;border-radius:var(--r-md);overflow:auto;font-size:.9em}
:not(pre)>code{background:var(--card);padding:.1em .35em;border-radius:var(--r-sm);font-size:.9em}
table{border-collapse:collapse;width:100%}
th,td{border:1px solid var(--rule);padding:.4rem .6rem}
blockquote{margin:0;padding-left:1rem;border-left:3px solid var(--rule);color:var(--muted)}
/* How the agent framed the review, at the top of what it is about. */
.framing{margin:0 0 1.6rem;padding:.75rem 1rem;background:var(--card);border:1px solid var(--rule);border-left:3px solid var(--accent);border-radius:var(--r-tab-lg);font-family:var(--sans);font-size:var(--fs-md);line-height:1.5}
.framing .text{white-space:pre-wrap}
.framing h2{font-size:var(--fs-sm);letter-spacing:.04em;text-transform:uppercase;color:var(--muted);margin:0 0 .3rem;font-weight:600}
.block{position:relative;border-radius:var(--r-md);padding:.15rem .5rem;margin:.2rem -.5rem;outline:none;transition:background .15s}
/* A drawn diagram. The picture is the review surface: its own shapes carry
   the anchors, so the arrow that is wrong is the thing you click. The source
   is a toggle away, with the same anchors on the same statements. */
.diagram{margin:0;padding:0}
.diagram .pic{overflow-x:auto;padding:.6rem 0}
.diagram svg{max-width:100%;height:auto}
.diagram figcaption{margin:.1rem 0 .2rem}
.diagram .flip{font:inherit;font-family:var(--sans);font-size:var(--fs-sm);padding:.15rem .55rem;border:1px solid var(--rule);border-radius:var(--r-md);background:transparent;color:var(--muted);cursor:pointer}
.diagram .flip:hover{color:var(--fg)}
.diagram figcaption .hint{margin-left:.5rem;color:var(--muted);font-size:var(--fs-xs)}
/* The drawing is rendered by mermaid's own CLI, with mermaid's own palette —
   but the SVG is rewritten on the way out (internal/diagram/palette.go) so
   every colour it chose reads one of these variables instead. That is why
   nothing here has to outrank mermaid's id-keyed stylesheet: the page names
   the colours, the stylesheet asks for them. A custom property also inherits
   and carries no specificity, so a hovered or answered shape recolours itself
   by setting one below. */
.diagram .pic{--mg-node-fill:var(--card);--mg-node-stroke:var(--rule);--mg-cluster-fill:transparent;--mg-text:var(--fg);--mg-label-bg:var(--bg);--mg-line:var(--muted);--mg-bad:var(--bad)}
.diagram [data-anchor]{cursor:pointer}
.diagram .mg-hit{stroke:transparent}
/* A shape that carries notes wears the marker colour; the one under the
   pointer wears the accent, and says so last so it wins on an answered shape.
   Both work by handing the shape a different value for the variables its own
   stylesheet already reads. */
.diagram .pic [data-anchor][data-count]:not([data-count="0"]){--mg-line:var(--marker);--mg-node-stroke:var(--marker)}
.diagram .pic [data-anchor][data-hover]{--mg-line:var(--accent);--mg-node-stroke:var(--accent);--mg-text:var(--accent)}
/* Weight is the one thing still taken by force: mermaid sets it per edge class
   (.edge-thickness-normal) and per node rule, neither of which reads a
   variable, and a highlight two pixels wide is not one. */
.diagram .pic g[data-anchor][data-hover] rect,.diagram .pic g[data-anchor][data-hover] polygon,.diagram .pic g[data-anchor][data-hover] circle{stroke-width:2.5px!important}
.diagram .pic g[data-anchor][data-count]:not([data-count="0"]) rect,.diagram .pic g[data-anchor][data-count]:not([data-count="0"]) polygon,.diagram .pic g[data-anchor][data-count]:not([data-count="0"]) circle{stroke-width:3px!important}
.diagram .pic path[data-anchor]:not(.mg-hit)[data-hover],.diagram .pic path[data-anchor]:not(.mg-hit)[data-count]:not([data-count="0"]){stroke-width:3px!important}
/* The requester's own note about a block — the agent asking, not the human
   answering, so it reads differently from a feedback item. */
.sidenote{margin:.4rem 0 .3rem;padding:.4rem .7rem;border-left:2px dashed var(--accent);background:color-mix(in srgb,var(--accent) var(--tint-weak),transparent);border-radius:var(--r-tab);font-family:var(--sans);font-size:var(--fs-base);white-space:pre-wrap}
.sidenote .who{display:block;color:var(--muted);font-size:var(--fs-sm);text-transform:uppercase;letter-spacing:.03em}
.framing .unanchored{margin-top:.5rem;color:var(--muted);font-size:var(--fs-base)}
/* Skipped blocks: collapsed behind one summary so the page opens on the part
   that is actually under review. */
.skipped{margin:.6rem 0;border:1px dashed var(--rule);border-radius:var(--r-lg);padding:0 .7rem}
.skipped>summary{cursor:pointer;color:var(--muted);font-family:var(--sans);font-size:var(--fs-base);padding:.45rem 0}
.skipped[open]{padding-bottom:.5rem}
/* Read-only blocks are context, not questions: they read normally and do
   nothing when tapped. */
.block[data-readonly="1"]:hover{background:none}
/* Muted, so the reviewer can see at a glance where their attention is not
   wanted rather than finding out by tapping. */
.block[data-readonly="1"]{cursor:default;color:var(--muted)}
@media (prefers-reduced-motion:reduce){.block,.toast{transition:none}}
.block:hover{background:color-mix(in srgb,var(--accent) var(--tint),transparent)}
.block:focus-visible{box-shadow:var(--ring)}
li.block{list-style-position:outside}
/* A mermaid fence anchors statement by statement, so its anchors are inline
   spans over the source itself: no box, no margin, nothing that would move a
   character of the diagram the author wrote. */
pre .block{display:inline;margin:0;padding:0 .1rem;border-radius:var(--r-sm)}
/* Its comment badge therefore follows the statement instead of sitting in the
   margin, which inside a <pre> would push the line sideways. */
pre .block[data-count]:not([data-count="0"])::before{content:none}
pre .block[data-count]:not([data-count="0"])::after{display:inline-block;margin-left:.4rem;min-width:1.15rem;height:1.15rem;line-height:1.15rem;font-size:var(--fs-2xs);vertical-align:.05rem}
.existing .on,.composer .on{color:var(--muted);font-family:var(--mono);font-size:var(--fs-sm);margin-bottom:.35rem;overflow-wrap:anywhere}
li.block>.existing,li.block>.composer{font-size:var(--fs-base)}
li.block[data-count]:not([data-count="0"])::before{left:-1.7rem}
/* One badge, two places it can sit: in the margin beside a block, or after a
   statement inside a diagram, where the margin belongs to the source. */
.block[data-count]:not([data-count="0"])::before,pre .block[data-count]:not([data-count="0"])::after{content:attr(data-count);min-width:1.3rem;height:1.3rem;line-height:1.3rem;text-align:center;background:var(--badge,var(--marker));color:var(--badge-fg,var(--on-marker));border-radius:var(--r-round);font-size:var(--fs-xs);font-family:var(--sans)}
.block[data-count]:not([data-count="0"])::before{position:absolute;left:-2.4rem;top:.3rem}
.composer{margin:.4rem 0 .8rem;background:var(--card);border:1px solid var(--rule);border-radius:var(--r-lg);padding:.8rem;box-shadow:var(--shadow);font-family:var(--sans);font-size:var(--fs-md)}
.composer .chips{display:flex;gap:.4rem;margin-bottom:.5rem;flex-wrap:wrap}
.composer .chip{padding:.25rem .7rem;border:1px solid var(--rule);border-radius:var(--r-pill);background:transparent;color:var(--fg);cursor:pointer;font:inherit}
.composer .chip[aria-pressed="true"]{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
.composer .chip .k{margin-left:.35rem;opacity:.65;font-size:.78em;font-family:var(--mono)}
.composer .fields{display:flex;flex-wrap:wrap;gap:.5rem;margin:.1rem 0 .5rem}
.composer .fields label{display:flex;flex-direction:column;gap:.15rem;font-size:var(--fs-sm);color:var(--muted)}
.composer .fields select,.composer .fields input{font:inherit;font-size:var(--fs-base);padding:.3rem;border:1px solid var(--rule);border-radius:var(--r-md);background:var(--bg);color:var(--fg)}
.existing .item .vals{margin-top:.2rem;color:var(--muted);font-size:.95em}
.composer textarea{width:100%;min-height:4rem;font:inherit;padding:.5rem;border:1px solid var(--rule);border-radius:var(--r-md);background:var(--bg);color:var(--fg);resize:vertical}
.composer .actions{display:flex;gap:.5rem;margin-top:.5rem}
.composer .actions button{font:inherit;padding:.35rem .8rem;border-radius:var(--r-md);cursor:pointer;border:1px solid var(--rule);background:transparent;color:var(--fg)}
.composer .actions .save{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
.existing{margin:.3rem 0 .6rem;font-family:var(--sans);font-size:var(--fs-base)}
.existing .item{padding:.4rem .6rem;border-left:2px solid var(--marker);margin:.3rem 0;background:var(--card);border-radius:var(--r-tab)}
.existing .item .type{font-weight:600;text-transform:capitalize;color:var(--accent)}
.existing .item.current{border-left-width:3px}
.existing .item .tag{margin-left:.4rem;padding:0 .35rem;border:1px solid var(--rule);border-radius:var(--r-pill);font-size:var(--fs-xs);color:var(--muted);text-transform:none;font-weight:400}
.existing .item .was{margin-top:.2rem;color:var(--muted);font-style:italic}
/* Where a note stands in the revision loop, as a chip on the note itself.
   Colour says it at a glance; the word says it for anyone who cannot use the
   colour, which is why both are always present. */
.existing .item .status{margin-left:.4rem;padding:0 .4rem;border-radius:var(--r-pill);font-size:var(--fs-xs);font-weight:600;text-transform:none;border:1px solid transparent}
.existing .item[data-status="addressed"] .status{background:color-mix(in srgb,var(--accent) var(--tint-weak),transparent);color:var(--accent);border-color:var(--accent)}
.existing .item[data-status="confirmed"] .status{background:color-mix(in srgb,var(--ok) var(--tint-weak),transparent);color:var(--ok);border-color:var(--ok)}
.existing .item[data-status="reopened"] .status{background:color-mix(in srgb,var(--bad) var(--tint-weak),transparent);color:var(--bad);border-color:var(--bad)}
.existing .item[data-status="confirmed"]{opacity:.72}
/* What the agent says it changed, and the one check we can run on the claim. */
.existing .changed{margin:.35rem 0 0 .2rem;border-left:2px solid var(--accent);padding-left:.6rem}
.existing .changed .who{font-weight:600;color:var(--muted);font-size:var(--fs-sm);margin-right:.35rem}
.existing .changed .unclaimed{display:block;margin-top:.2rem;color:var(--bad);font-size:var(--fs-sm)}
.existing .verdict{display:flex;gap:.4rem;margin-top:.45rem;align-items:center;flex-wrap:wrap}
.existing .verdict button{font:inherit;font-size:var(--fs-sm);padding:.2rem .7rem;border-radius:var(--r-pill);cursor:pointer;border:1px solid var(--rule);background:transparent;color:var(--fg)}
.existing .verdict .yes:hover{border-color:var(--ok);color:var(--ok)}
.existing .verdict .no:hover{border-color:var(--bad);color:var(--bad)}
.existing .verdict .ask{color:var(--muted);font-size:var(--fs-sm)}
/* A thread: the answers to one note, indented under it. One level deep, so
   the rule is a rule and not the first step of a tree. */
.existing .thread{margin:.35rem 0 0 .2rem;border-left:1px solid var(--rule);padding-left:.6rem}
.existing .reply{margin:.25rem 0}
.existing .reply .who{font-weight:600;color:var(--muted);font-size:var(--fs-sm);margin-right:.35rem}
.existing .replybtn{font:inherit;font-size:var(--fs-sm);margin-top:.3rem;padding:.1rem .5rem;border:1px solid var(--rule);border-radius:var(--r-pill);background:transparent;color:var(--muted);cursor:pointer}
.existing .replybtn:hover{color:var(--fg);border-color:var(--accent)}
.existing .replybox{margin-top:.4rem}
.existing .replybox textarea{width:100%;min-height:2.6rem;font:inherit;font-size:var(--fs-base);padding:.4rem;border:1px solid var(--rule);border-radius:var(--r-md);background:var(--bg);color:var(--fg);resize:vertical}
.existing .replybox .row{display:flex;gap:.4rem;margin-top:.35rem}
.existing .replybox button{font:inherit;font-size:var(--fs-sm);padding:.25rem .7rem;border-radius:var(--r-md);cursor:pointer;border:1px solid var(--rule);background:transparent;color:var(--fg)}
.existing .replybox .send{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
/* A block waiting on the reviewer wears a ring, so the second round is a
   scan rather than a re-read. Settled blocks recede. */
.block[data-status="addressed"][data-count]:not([data-count="0"])::before,pre .block[data-status="addressed"][data-count]:not([data-count="0"])::after{box-shadow:0 0 0 2px var(--bg),0 0 0 3px var(--accent)}
.block[data-status="confirmed"]{--badge:var(--ok);--badge-fg:var(--on-accent)}
/* What was decided colours the badge, wherever it sits. */
.block[data-state="approve"]{--badge:var(--ok);--badge-fg:var(--on-accent)}
.block[data-state="reject"]{--badge:var(--bad);--badge-fg:var(--on-accent)}
.block[data-stale="1"][data-count]:not([data-count="0"])::before,pre .block[data-stale="1"][data-count]:not([data-count="0"])::after{box-shadow:0 0 0 2px var(--bg),0 0 0 3px var(--muted)}
/* Share mode: the one place a human has to copy something out. */
.share{margin:2rem 0 1rem;padding:.8rem 1rem;background:var(--card);border:1px solid var(--rule);border-radius:var(--r-lg);font-family:var(--sans);font-size:var(--fs-base)}
.share h2{font-size:var(--fs-md);margin:0 0 .3rem}
.share p{color:var(--muted);margin:0 0 .5rem}
.share textarea{width:100%;min-height:8rem;font-family:var(--mono);font-size:var(--fs-sm);padding:.5rem;border:1px solid var(--rule);border-radius:var(--r-md);background:var(--bg);color:var(--fg)}
.share .row{display:flex;align-items:center;gap:.6rem;margin-top:.5rem;flex-wrap:wrap}
.share .row button{font:inherit;padding:.35rem .8rem;border-radius:var(--r-md);cursor:pointer;border:1px solid var(--accent);background:var(--accent);color:var(--on-accent)}
.share .hint{color:var(--muted)}
.offline{color:var(--muted);font-style:italic}
.offline code{font-style:normal;font-size:.9em}
.orphans{margin:2.5rem 0 1rem;padding-top:1rem;border-top:1px solid var(--rule);font-family:var(--sans);font-size:var(--fs-base)}
.orphans h2{font-size:var(--fs-lg);margin:0 0 .2rem}
.orphans p{color:var(--muted);margin:0 0 .8rem}
.orphans .item{padding:.5rem .7rem;margin:.4rem 0;background:var(--card);border-left:2px solid var(--muted);border-radius:var(--r-tab)}
.orphans .meta{color:var(--muted)}
.orphans .was{color:var(--muted);font-style:italic;margin:.15rem 0}
main.tree{--step:1.25rem;max-width:110ch;font-family:var(--mono);font-size:var(--fs-md);line-height:1.5}
main.tree .block{display:flex;align-items:flex-start;gap:.1rem;margin:0 -.5rem;padding:.05rem .5rem;padding-left:calc(.5rem + var(--lvl,0)*var(--step))}
/* Depth as a variable so indentation needs no inline styles and no script. */
main.tree .block[data-level="1"]{--lvl:1}main.tree .block[data-level="2"]{--lvl:2}main.tree .block[data-level="3"]{--lvl:3}main.tree .block[data-level="4"]{--lvl:4}main.tree .block[data-level="5"]{--lvl:5}main.tree .block[data-level="6"]{--lvl:6}main.tree .block[data-level="7"]{--lvl:7}main.tree .block[data-level="8"]{--lvl:8}main.tree .block[data-level="9"]{--lvl:9}main.tree .block[data-level="10"]{--lvl:10}main.tree .block[data-level="11"]{--lvl:11}main.tree .block[data-level="12"]{--lvl:12}main.tree .block[data-level="13"]{--lvl:13}main.tree .block[data-level="14"]{--lvl:14}main.tree .block[data-level="15"]{--lvl:15}main.tree .block[data-level="16"]{--lvl:16}main.tree .block[data-level="17"]{--lvl:17}main.tree .block[data-level="18"]{--lvl:18}main.tree .block[data-level="19"]{--lvl:19}main.tree .block[data-level="20"]{--lvl:20}main.tree .block[data-level="21"]{--lvl:21}main.tree .block[data-level="22"]{--lvl:22}main.tree .block[data-level="23"]{--lvl:23}main.tree .block[data-level="24"]{--lvl:24}
/* Deep trees on a phone: tighten the indent step rather than scroll sideways. */
@media (max-width:640px){main.tree{--step:.7rem;font-size:var(--fs-base)}}
main.tree .body{flex:1;min-width:0}
main.tree .cmt{display:block;color:var(--muted);font-style:italic;overflow-wrap:break-word}
main.tree .body>code{background:none;padding:0;font-size:1em;white-space:pre-wrap;overflow-wrap:break-word}
main.tree .block[data-kind="message"] code,main.tree .block[data-kind="service"] code,main.tree .block[data-kind="enum"] code,main.tree .block[data-kind="oneof"] code,main.tree .block[data-kind="object"] code,main.tree .block[data-kind="array"] code,main.tree .block[data-kind="diagram"] code,main.tree .block[data-kind="subgraph"] code{font-weight:600}
main.tree .key{color:var(--accent)}
main.tree .punct,main.tree .meta{color:var(--muted)}
main.tree .caret{flex:0 0 1.1rem;font:inherit;line-height:1.5;width:1.1rem;padding:0;border:0;background:none;color:var(--muted);cursor:pointer;text-align:left}
main.tree .caret[hidden]{display:block!important;visibility:hidden;cursor:default}
main.tree .trail{display:inline;margin-left:.5rem}
main.tree .existing,main.tree .composer{font-family:var(--sans)}
header #fold{background:transparent;color:var(--fg);border-color:var(--rule);margin-left:auto}
header #fold+button{margin-left:.5rem}
.reloader{position:fixed;bottom:1rem;right:1rem;display:flex;align-items:center;gap:.6rem;background:var(--card);border:1px solid var(--accent);box-shadow:var(--shadow);border-radius:var(--r-lg);padding:.5rem .7rem;font-family:var(--sans);font-size:var(--fs-base)}
.reloader button{font:inherit;padding:.25rem .6rem;border:1px solid var(--accent);background:var(--accent);color:var(--on-accent);border-radius:var(--r-md);cursor:pointer}
.toast{position:fixed;bottom:1rem;left:50%;transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:.5rem 1rem;border-radius:var(--r-md);font-family:var(--sans);font-size:var(--fs-base);opacity:0;transition:opacity .2s;pointer-events:none}
.toast.show{opacity:1}
</style>
</head>
<body>
<header>
  <strong>{{.Title}}</strong>
  {{if and .ShowNav (ne .Title .Doc.Path)}}<span class="where">{{.Doc.Path}}</span>{{end}}
  <span class="count" id="count">0 comments</span>
  <span class="progress" id="progress" hidden>
    <span class="bar"><span class="fill" id="progfill"></span></span>
    <span class="of" id="progtext"></span>
  </span>
  <span class="actions">
    <details class="filter" id="filter">
      <summary>Show all</summary>
      <div class="panel">
        <div class="group" role="group" aria-label="Which blocks to show">
          <span class="opts" id="filters">
            <button type="button" data-filter="all" aria-pressed="true">All</button><button type="button" data-filter="unanswered">Not answered</button><button type="button" data-filter="mine">I answered</button><button type="button" data-filter="noted">Requester asked</button><button type="button" data-filter="recheck">To re-check</button>
          </span>
        </div>
        <p class="hint">Hiding a block hides its notes with it. Nothing is lost — the count below says how many are out of view.</p>
      </div>
    </details>
    <details class="display" id="display">
      <summary>Display</summary>
      <div class="panel">
        <div class="group" role="group" aria-label="Colour theme">
          <span>Theme</span>
          <span class="opts" id="modes">
            <button type="button" data-mode="system">System</button><button type="button" data-mode="light">Light</button><button type="button" data-mode="dark">Dark</button>
          </span>
        </div>
        <div class="group" role="group" aria-label="Code ligatures">
          <span>Ligatures</span>
          <span class="opts" id="ligs">
            <button type="button" data-lig="on">On</button><button type="button" data-lig="off">Off</button>
          </span>
        </div>
      </div>
    </details>
    {{if .Doc.IsTree}}<button id="fold" type="button" class="secondary" aria-pressed="false">Collapse all</button>{{end}}
    {{if .Static}}<button id="reveal" type="button" class="secondary">Export…</button>{{end}}
    {{if .ShowNav}}<button id="done" type="button" class="secondary">Done with this file</button>
    <button id="finish" type="button">Finish review set{{if .SetDone}} ✓{{end}}</button>
    {{else}}<button id="done" type="button">{{if .Static}}Mark done{{else}}Done{{end}}</button>{{end}}
  </span>
</header>
<div class="layout">
{{if .ShowNav}}
<aside class="nav">
  <details open>
    <summary id="setcount">{{.Total}} documents · {{.DoneN}} done</summary>
    {{template "navlist" .Nav}}
  </details>
</aside>
{{end}}
<main id="doc"{{if .Doc.IsTree}} class="tree{{if eq .Doc.Format "diff"}} diff{{end}}"{{end}}>
  {{if .Review.Instructions}}
  <section class="framing" aria-label="What you are being asked to review">
    <h2>What to look at</h2>
    <div class="text">{{.Review.Instructions}}</div>
  </section>
  {{end}}
  {{range .Doc.Blocks}}{{if not .Inline}}
  <div class="block" data-block="{{.ID}}" data-hash="{{.Hash}}" data-quote="{{.Quote}}" data-kind="{{.Kind}}" data-level="{{.Level}}" data-parent="{{.Parent}}"{{if .HasChildren}} data-kids="1"{{end}} tabindex="0" role="button" aria-label="Block {{.ID}}">{{if .SVG}}<figure class="diagram">
    <div class="pic">{{safe .SVG}}</div>
    <div class="src" hidden>{{safe .HTML}}</div>
    <figcaption><button class="flip" type="button" aria-pressed="false">Show source</button><span class="hint">click a shape to comment on it</span></figcaption>
  </figure>{{else}}{{safe .HTML}}{{end}}</div>
  {{end}}{{end}}
  {{if .Static}}
  <section class="share" id="share" hidden aria-label="Send your review back">
    <h2>Send this back</h2>
    <p>There is no server here, so your comments live in this browser until you
      hand them over. The text below is already selected — press ⌘C / Ctrl+C —
      or download it as a file.</p>
    <textarea id="sharejson" readonly spellcheck="false" aria-label="Your review as JSON"></textarea>
    <div class="row">
      <button id="download" type="button">Download JSON</button>
      <span class="hint" id="sharehint"></span>
    </div>
  </section>
  {{end}}
  {{if .Orphans}}
  <section class="orphans" aria-label="Notes that no longer anchor">
    <h2>{{.OrphanTitle}}</h2>
    <p>The document no longer has the blocks these were written against.</p>
    {{range .Orphans}}
    <div class="item">
      <div class="meta"><code>{{.Block}}</code> · {{.Current.Event.Type}} · {{.Current.Event.Author}}</div>
      <div class="was">was: “{{.Current.Event.Quote}}”</div>
      <div>{{.Current.Event.Text}}</div>
    </div>
    {{end}}
  </section>
  {{end}}
</main>
</div>
<div class="reloader" id="reloader" role="status" aria-live="polite" hidden>
  <span>This document changed on disk.</span>
  <button type="button" id="reload">Reload</button>
</div>
<div class="outstanding" id="outstanding" hidden>
  <h2 id="outstanding-title"></h2>
  <p>This review asks for a verdict on every block. These are still waiting — click one to go there.</p>
  <div class="list" id="outstanding-list"></div>
  <button type="button" class="secondary" id="outstanding-close">Dismiss</button>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
window.__MARGINALIA__ = {{.DataJSON}};
(function(){
  "use strict";
  var data = window.__MARGINALIA__;
  var author = data.author || "reviewer";
  // The vocabulary comes from the server, not from here: an agent can add its
  // own actions at serve time, and the page must offer exactly what the
  // server will accept.
  var actions = (data.review && data.review.actions) || [];
  var labelOf = {}, byKey = {};
  actions.forEach(function(a){
    labelOf[a.type] = a.label || a.type;
    if(a.key) byKey[a.key] = a;
  });
  // An action with nothing to fill in is one tap — most feedback is a
  // verdict, not prose, and making the reviewer type "nit" is how a long
  // document stops being reviewed.
  function needsInput(a){ return !!(a.requires_text || (a.fields && a.fields.length)); }
  var blockOf = {}; data.doc.blocks.forEach(function(b){ blockOf[b.id]=b; });
  // Notes come from the server's materialized view: it has compared each
  // event's hash against the block as it now reads, so the page shows what
  // still applies rather than guessing.
  var res = data.resolution || {states:[]};
  var byBlock = {};
  (res.states||[]).forEach(function(st){ if(!st.orphaned) byBlock[st.block] = st.history || []; });
  var unanchored = res.orphaned || 0;

  function staleCount(){
    var n=0;
    Object.keys(byBlock).forEach(function(k){
      var list=byBlock[k];
      if(list.length && list[list.length-1].stale) n++;
    });
    return n;
  }
  function count(){
    var n=0, outstanding=0, addressed=0;
    Object.keys(byBlock).forEach(function(k){
      byBlock[k].forEach(function(note){
        n++;
        var st = note.status || "outstanding";
        // An approve asks for nothing, so it is not work left to do — the
        // same rule the server's materialized view applies.
        if(st==="addressed") addressed++;
        else if(st!=="confirmed" && note.event.type!=="approve" && !note.dangling) outstanding++;
      });
    });
    progress();
    var parts=[n+" comment"+(n===1?"":"s")];
    // The second round's queue, said first, because on a re-read it is the
    // only number that tells the reviewer how much is left.
    if(addressed) parts.push(addressed+" to re-check");
    if(outstanding) parts.push(outstanding+" outstanding");
    var stale=staleCount();
    if(stale) parts.push(stale+" stale");
    if(unanchored) parts.push(unanchored+" unanchored");
    document.getElementById("count").textContent = parts.join(" · ");
  }
  function toast(m){ var t=document.getElementById("toast"); t.textContent=m; t.classList.add("show"); setTimeout(function(){t.classList.remove("show");},1800); }
  // The badge says how much was said about a block; its colour says what was
  // decided, and a ring says the block has changed since.
  function marker(el){
    var list = byBlock[el.dataset.block] || [];
    el.dataset.count = list.length;
    var current = list.length ? list[list.length-1] : null;
    if(current){
      el.dataset.state = current.event.type;
      if(current.stale) el.dataset.stale = "1"; else delete el.dataset.stale;
    }
    // The most urgent thing anyone is waiting on for this block, so a
    // returning reviewer can scan for work instead of reading. A block whose
    // notes are all settled asks for nothing and says so quietly.
    carry(el, "status", urgency(list));
    mirror(el);
  }
  // Ranked by who is being waited on: a reopened note is the agent's problem,
  // an addressed one is the reviewer's, an outstanding one is still the
  // agent's, and a settled one is nobody's.
  function urgency(list){
    var rank = {reopened:3, addressed:2, outstanding:1, confirmed:0}, best = "", top = -1;
    list.forEach(function(note){
      var st = note.status || "outstanding";
      if(st==="outstanding" && note.event.type==="approve") st = "confirmed";
      if(rank[st] > top){ top = rank[st]; best = st; }
    });
    return best;
  }
  // The picture and the source are one surface, so a drawn shape wears the
  // badge state of the statement it is: how much was said, what was decided,
  // whether the diagram moved on since. Nothing to do for a block no diagram
  // drew.
  function mirror(el){
    Array.prototype.forEach.call(shapesOf(el.dataset.block), function(s){
      carry(s, "count", el.dataset.count);
      carry(s, "state", el.dataset.state);
      carry(s, "stale", el.dataset.stale);
    });
  }
  function carry(to, key, v){ if(v) to.dataset[key] = v; else delete to.dataset[key]; }
  // shapesOf finds every drawn shape standing for one block: the arrow and
  // the invisible copy that takes its clicks, or a box and its cluster.
  function shapesOf(block){
    return document.querySelectorAll('.diagram .pic [data-anchor="' + block + '"]');
  }
  function hover(target, on){
    var shape = target.closest && target.closest("[data-anchor]");
    if(!shape) return;
    Array.prototype.forEach.call(shapesOf(shape.dataset.anchor), function(s){
      carry(s, "hover", on ? "1" : "");
    });
  }
  // A block's comment list and composer go after it — except inside a list
  // item, where "after" would mean between two <li>s. There they go after the
  // item's own text and before anything nested under it, so a note about a
  // bullet never reads as a note about its sub-bullets.
  function nestedList(el){ return el.querySelector(":scope > ul, :scope > ol"); }
  // Inside a mermaid fence "after the statement" would mean inside the <pre>,
  // which would break the diagram's own layout — so those boxes sit under the
  // whole fence, each after the statement above it, so they read in the order
  // the diagram does however they were added.
  function afterInPre(pre, el){
    var anchor = pre, spans = pre.querySelectorAll(".block");
    for(var i = 0; i < spans.length; i++){
      var box = spans[i].mg_existing;
      if(box && box.isConnected) anchor = box;
      if(spans[i] === el) break;
    }
    return anchor;
  }
  function attach(el, box){
    // A statement of a drawn diagram: its notes belong under the whole
    // figure, where they are visible in both the picture and the source.
    var fig = el.closest("figure.diagram");
    if(fig){
      label(el, box);
      var last = fig;
      while(isBoxEl(last.nextElementSibling)) last = last.nextElementSibling;
      last.after(box);
      return;
    }
    var pre = el.closest("pre");
    if(pre){
      label(el, box);
      afterInPre(pre, el).after(box);
      return;
    }
    if(el.tagName !== "LI"){ el.after(box); return; }
    var nested = nestedList(el);
    if(nested) el.insertBefore(box, nested); else el.appendChild(box);
  }
  // Several statements of one diagram share the space below it, so each box
  // says which statement it is about.
  function label(el, box){
    var parts = el.dataset.block.split("/");
    var on = document.createElement("div");
    on.className = "on"; on.textContent = parts[parts.length-1];
    box.insertBefore(on, box.firstChild);
  }
  function isBoxEl(el){ return !!el && (el.classList.contains("existing") || el.classList.contains("composer")); }
  function boxAfter(el, cls){
    var box;
    if(el.closest("pre")){
      box = el["mg_"+cls];
      return box && box.isConnected ? box : null;
    }
    if(el.tagName === "LI"){
      var nested = nestedList(el);
      box = nested ? nested.previousElementSibling : el.lastElementChild;
    } else {
      box = el.nextElementSibling;
    }
    return box && box.classList.contains(cls) ? box : null;
  }
  function renderExisting(el){
    var id=el.dataset.block, list=byBlock[id]||[];
    var box=boxAfter(el, "existing");
    if(box) box.remove();
    if(!list.length) return;
    box=document.createElement("div"); box.className="existing";
    list.forEach(function(note, i){
      var e = note.event;
      var item=document.createElement("div"); item.className="item";
      if(i === list.length-1) item.classList.add("current");
      var t=document.createElement("span"); t.className="type"; t.textContent=labelOf[e.type] || e.type.replace("_"," ");
      item.appendChild(t);
      if(note.stale){
        item.classList.add("stale");
        var tag=document.createElement("span"); tag.className="tag";
        // Say which thing moved. For a note about one sentence, "the block
        // changed" is true of almost every edit and tells the reader nothing;
        // what makes this note stale is that its own sentence is gone.
        tag.textContent = e.sub ? "stale — this sentence was edited" : "stale — block edited since";
        item.appendChild(tag);
      }
      // What the note is about, when it is about one sentence rather than the
      // block. Shown even when stale — especially then, since "the text this
      // was written against" is exactly what the reader needs.
      if(e.sub && e.sub.quote){
        var on=document.createElement("div"); on.className="quoted";
        on.textContent="\u201c"+e.sub.quote+"\u201d";
        item.appendChild(on);
        if(note.at){
          item.addEventListener("mouseenter", function(){ lightSub(el, note.at, true); });
          item.addEventListener("mouseleave", function(){ lightSub(el, note.at, false); });
        }
      }
      var body=document.createElement("div"); body.textContent=e.text||"";
      item.appendChild(body);
      if(e.fields){
        var keys=Object.keys(e.fields);
        if(keys.length){
          var vals=document.createElement("div"); vals.className="vals";
          vals.textContent=keys.map(function(k){ return k+": "+e.fields[k]; }).join(" · ");
          item.appendChild(vals);
        }
      }
      if(note.stale && e.quote){
        var was=document.createElement("div"); was.className="was"; was.textContent="was: \u201c"+e.quote+"\u201d";
        item.appendChild(was);
      }
      renderStatus(el, note, item);
      renderThread(el, note, item);
      box.appendChild(item);
    });
    el.mg_existing = box;
    attach(el, box);
  }
  // Where a note stands in the revision loop, and the verdict that moves it
  // on. This is the second round's whole interface: a reviewer coming back to
  // a document they already read needs to see which of their notes were acted
  // on, not re-read the document.
  function renderStatus(el, note, item){
    var status = note.status || "outstanding";
    item.dataset.status = status;
    if(status !== "outstanding"){
      var chip=document.createElement("span");
      chip.className="status"; chip.textContent=status;
      item.querySelector(".type").after(chip);
    }
    // What the agent says it changed — the claim the reviewer is being asked
    // to check. Only the latest one; the earlier rounds are history.
    var last = (note.progress||[]).slice().reverse().find(function(p){ return p.event.type==="addressed"; });
    if(last && status === "addressed"){
      var box=document.createElement("div"); box.className="changed";
      var who=document.createElement("span"); who.className="who";
      who.textContent=last.event.author || "agent";
      box.appendChild(who);
      var body=document.createElement("span"); body.textContent=last.event.text||"";
      box.appendChild(body);
      // The one check that can be run on the claim, shown where the claim is.
      if(note.unclaimed){
        var warn=document.createElement("span"); warn.className="unclaimed";
        // Name the thing that did not move. For a note about one sentence,
        // "this block has not changed" would be false as often as not.
        warn.textContent = note.event.sub
          ? "\u26a0 this sentence has not changed since — the edit may be elsewhere"
          : "\u26a0 this block has not changed since — the edit may be elsewhere";
        box.appendChild(warn);
      }
      item.appendChild(box);
    }
    if(status !== "addressed" && status !== "reopened") return;
    var row=document.createElement("div"); row.className="verdict";
    var ask=document.createElement("span"); ask.className="ask";
    ask.textContent = status === "addressed" ? "Is this right now?" : "Still open.";
    row.appendChild(ask);
    if(status === "addressed"){
      row.appendChild(verdictBtn(el, note, "confirm", "yes", "Yes, settled"));
      row.appendChild(verdictBtn(el, note, "reopen", "no", "No, still open"));
    } else {
      row.appendChild(verdictBtn(el, note, "confirm", "yes", "Settle it anyway"));
    }
    item.appendChild(row);
  }
  function verdictBtn(el, note, type, cls, label){
    var b=document.createElement("button");
    b.type="button"; b.className=cls; b.textContent=label;
    b.addEventListener("click", function(ev){ ev.stopPropagation(); saveProgress(el, note, type, ""); });
    return b;
  }
  // A verdict is an event like any other: append-only, naming the note it is
  // about. Nothing is rewritten — the status is re-derived from the log.
  function saveProgress(el, note, type, text){
    var id=el.dataset.block, blk=blockOf[id]||{};
    var ev={doc:data.doc.path,block:id,quote:blk.quote||el.dataset.quote||"",hash:blk.hash||el.dataset.hash||"",type:type,text:text,reply_to:note.id,author:author};
    function landed(saved){
      (note.progress=note.progress||[]).push({event:saved,stale:false,id:saved.id});
      note.status = type==="confirm" ? "confirmed" : (type==="reopen" ? "reopened" : "addressed");
      // Confirming does not un-do the check on the claim, but it does stop
      // the page nagging about it: the reviewer has looked and decided.
      if(type!=="addressed") note.unclaimed = false;
      renderExisting(el); count();
      toast(type==="confirm" ? "Settled" : "Reopened");
    }
    if(data.static){ landed(keep(ev)); refreshShare(); return; }
    fetch("/api/feedback",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(ev)})
      .then(function(res){ if(!res.ok) return res.text().then(function(t){throw new Error(t.trim());}); return res.json(); })
      .then(landed)
      .catch(function(err){ toast("Failed: "+err.message); });
  }
  // A thread: the answers to one note, and the way to add another. A note
  // without an id cannot be answered — that is a log written before replies
  // existed, or a reply whose own target is missing — so no affordance is
  // offered rather than one that would fail on save.
  function renderThread(el, note, item){
    (note.replies||[]).forEach(function(r){
      var thread = item.querySelector(":scope > .thread");
      if(!thread){ thread=document.createElement("div"); thread.className="thread"; item.appendChild(thread); }
      var line=document.createElement("div"); line.className="reply";
      var who=document.createElement("span"); who.className="who";
      who.textContent=r.event.author || "agent";
      line.appendChild(who);
      var body=document.createElement("span"); body.textContent=r.event.text||"";
      line.appendChild(body);
      thread.appendChild(line);
    });
    if(!note.id || note.dangling) return;
    var btn=document.createElement("button");
    btn.type="button"; btn.className="replybtn"; btn.textContent="Reply";
    btn.setAttribute("aria-expanded","false");
    btn.addEventListener("click", function(ev){ ev.stopPropagation(); openReply(el, note, item, btn); });
    item.appendChild(btn);
  }
  // openReply is deliberately not the composer: a reply has no vocabulary to
  // pick from and no fields to fill in — it is the one thing it is, so it is
  // a box and a button.
  function openReply(el, note, item, btn){
    var open = item.querySelector(":scope > .replybox");
    if(open){ open.remove(); btn.setAttribute("aria-expanded","false"); return; }
    var box=document.createElement("div"); box.className="replybox";
    var ta=document.createElement("textarea"); ta.placeholder="Your answer\u2026";
    var row=document.createElement("div"); row.className="row";
    var send=document.createElement("button"); send.type="button"; send.className="send"; send.textContent="Reply";
    var cancel=document.createElement("button"); cancel.type="button"; cancel.textContent="Cancel";
    function close(){ box.remove(); btn.setAttribute("aria-expanded","false"); }
    function submit(){
      var text=ta.value.trim();
      if(!text){ ta.focus(); return; }
      saveReply(el, note, text);
    }
    send.onclick=submit; cancel.onclick=close;
    ta.addEventListener("keydown", function(e){
      if(e.key==="Escape"){ e.preventDefault(); close(); return; }
      if(e.key==="Enter" && (e.metaKey||e.ctrlKey)){ e.preventDefault(); submit(); }
    });
    row.appendChild(send); row.appendChild(cancel);
    box.appendChild(ta); box.appendChild(row);
    item.appendChild(box);
    btn.setAttribute("aria-expanded","true");
    ta.focus();
  }
  // A reply lands under the note it answers and nowhere else: it is not the
  // block's current state, and it must not move a badge or the header count.
  // What the reviewer said is what those measure.
  function saveReply(el, note, text){
    var id=el.dataset.block, blk=blockOf[id]||{};
    var ev={doc:data.doc.path,block:id,quote:blk.quote||el.dataset.quote||"",hash:blk.hash||el.dataset.hash||"",type:"reply",text:text,reply_to:note.id,author:author};
    function landed(saved){
      (note.replies=note.replies||[]).push({event:saved,stale:false,id:saved.id});
      renderExisting(el);
      toast("Reply saved");
    }
    if(data.static){ landed(keep(ev)); refreshShare(); return; }
    fetch("/api/feedback",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(ev)})
      .then(function(res){ if(!res.ok) return res.text().then(function(t){throw new Error(t.trim());}); return res.json(); })
      .then(landed)
      .catch(function(err){ toast("Reply failed: "+err.message); });
  }
  // The replacement text a suggest_edit starts from: a markdown block's own
  // text, or — for a tree node — just its declaration line, without the
  // comment that documents it.
  function editableText(id, el){
    var code = isTree && el.querySelector("code");
    if(code) return code.textContent;
    // A diagram statement: the span holds the source, indentation and all.
    if(el.closest("pre")) return el.textContent.trim();
    var blk = blockOf[id];
    return blk ? blk.text : "";
  }
  function closeComposer(){ var c=document.querySelector(".composer"); if(c) c.remove(); }
  // save appends one event and folds it into the page without a reload. In
  // share mode there is no server to append to, so the browser is the store
  // and the reviewer hands the result over themselves — the one place in
  // Marginalia where a human has to copy something.
  function save(el, action, text, fields, selection){
    var id=el.dataset.block, blk=blockOf[id]||{};
    var ev={doc:data.doc.path,block:id,quote:blk.quote||el.dataset.quote||"",hash:blk.hash||el.dataset.hash||"",type:action.type,text:text,author:author};
    if(fields && Object.keys(fields).length) ev.fields=fields;
    // Only the quote. The server derives the rest against its own copy of the
    // block, which is the copy it will search when the note is read back.
    if(selection) ev.sub={quote:selection};
    function landed(saved){
      (byBlock[id]=byBlock[id]||[]).push({event:saved,stale:false,id:saved.id,at:saved.at,status:"outstanding"});
      marker(el); renderExisting(el); markSub(el); count(); bumpCurrentCount(); closeComposer();
      toast((labelOf[action.type]||"Note")+" saved");
    }
    if(data.static){ landed(keep(ev)); refreshShare(); return; }
    fetch("/api/feedback",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(ev)})
      .then(function(res){ if(!res.ok) return res.text().then(function(t){throw new Error(t.trim());}); return res.json(); })
      .then(landed)
      .catch(function(err){ toast("Save failed: "+err.message); });
  }
  // Share mode's store: this browser, under a key naming the document, so two
  // reviews open in the same browser do not overwrite each other. Storage can
  // throw or come back empty — a private window, cleared site data — so every
  // access is wrapped and the page still works, just without remembering.
  var localKey = "marginalia.review." + (data.doc && data.doc.path);
  var kept = [];
  function loadKept(){
    try{
      var raw = localStorage.getItem(localKey);
      if(raw) kept = JSON.parse(raw) || [];
    }catch(e){ kept = []; }
    if(!Array.isArray(kept)) kept = [];
  }
  function keep(ev){
    ev.ts = new Date().toISOString().replace(/\.\d+Z$/, "Z");
    kept.push(ev);
    try{ localStorage.setItem(localKey, JSON.stringify(kept)); }
    catch(e){ toast("This browser will not remember it — export before closing the tab."); }
    return ev;
  }
  // openComposer offers the review's vocabulary for one block. want is the
  // action to start on — a keyboard shortcut that needs words arrives here
  // with the action already chosen.
  function openComposer(el, want, selection){
    closeComposer();
    var id=el.dataset.block, current=want||actions[0];
    if(!current) return;
    var c=document.createElement("div"); c.className="composer";
    // What the note is about, when it is about less than the whole block.
    if(selection){
      var on=document.createElement("div"); on.className="quoted";
      on.textContent="\u201c"+selection+"\u201d";
      c.appendChild(on);
    }
    var chips=document.createElement("div"); chips.className="chips";
    var fieldBox=document.createElement("div"); fieldBox.className="fields";
    var ta=document.createElement("textarea"); ta.placeholder="Your note…";
    var inputs={};
    // The structured values an action collects: a choice where it has
    // options, free text where it does not.
    function renderFields(){
      fieldBox.textContent=""; inputs={};
      (current.fields||[]).forEach(function(f){
        var wrap=document.createElement("label");
        var name=document.createElement("span");
        name.textContent=(f.label||f.name)+(f.required?" *":"");
        var input;
        if(f.options && f.options.length){
          input=document.createElement("select");
          // A placeholder even when the field is required: a select that
          // starts on its first option saves a severity nobody chose.
          input.appendChild(new Option(f.required ? "— pick one —" : "—", ""));
          f.options.forEach(function(o){ input.appendChild(new Option(o,o)); });
        } else {
          input=document.createElement("input"); input.type="text";
        }
        inputs[f.name]=input;
        wrap.appendChild(name); wrap.appendChild(input);
        fieldBox.appendChild(wrap);
      });
      fieldBox.hidden = !fieldBox.childElementCount;
    }
    function select(a){
      current=a;
      Array.prototype.forEach.call(chips.querySelectorAll(".chip"), function(x){
        x.setAttribute("aria-pressed", x.dataset.type===a.type ? "true" : "false");
      });
      if(a.type==="suggest_edit" && !ta.value) ta.value=editableText(id, el);
      renderFields();
    }
    actions.forEach(function(a){
      var b=document.createElement("button"); b.type="button"; b.className="chip"; b.dataset.type=a.type;
      b.textContent=a.label||a.type;
      if(a.key){ var k=document.createElement("span"); k.className="k"; k.textContent=a.key; b.appendChild(k); }
      b.setAttribute("aria-pressed", a.type===current.type ? "true" : "false");
      b.onclick=function(){
        // An action with nothing to fill in saves on the tap — unless the
        // reviewer has started writing, in which case they want their words
        // kept and the tap only picks the type.
        if(!needsInput(a) && !ta.value.trim()){ save(el, a, "", {}, selection); return; }
        select(a);
      };
      chips.appendChild(b);
    });
    var row=document.createElement("div"); row.className="actions";
    var saveBtn=document.createElement("button"); saveBtn.className="save"; saveBtn.type="button"; saveBtn.textContent="Save";
    var cancel=document.createElement("button"); cancel.type="button"; cancel.textContent="Cancel"; cancel.onclick=closeComposer;
    saveBtn.onclick=function(){
      var text=ta.value.trim();
      if(current.requires_text && !text){ ta.focus(); return; }
      var fields={}, missing=null;
      (current.fields||[]).forEach(function(f){
        var v=(inputs[f.name].value||"").trim();
        if(v) fields[f.name]=v;
        if(f.required && !v && !missing) missing=inputs[f.name];
      });
      if(missing){ missing.focus(); return; }
      save(el, current, text, fields, selection);
    };
    row.appendChild(saveBtn); row.appendChild(cancel);
    c.appendChild(chips); c.appendChild(fieldBox); c.appendChild(ta); c.appendChild(row);
    el.mg_composer = c;
    renderFields();
    attach(el, c); ta.focus();
  }
  // --- commenting on a sentence -------------------------------------------
  //
  // The smallest thing you could comment on was a block, so "this sentence
  // contradicts §4" arrived attached to six sentences. A selection now carries
  // a sub-anchor: the quote, and enough of what surrounds it to find again.
  //
  // Two rules the implementation is shaped by. Selecting text must keep
  // working — you copy quotes out of documents — so nothing is hijacked on
  // mouseup; an offer appears and you take it or ignore it. And the page never
  // computes the anchor: it sends the quote, and the server derives the rest
  // against its own copy of the block, so the two cannot disagree about text
  // the reviewer is looking at.
  var selBtn = null, pending = null;
  function clearSelOffer(){
    if(selBtn){ selBtn.remove(); selBtn = null; }
    pending = null;
  }
  // A selection is anchorable when it sits inside exactly one block, that
  // block is commentable, and the text it selected is actually in the block's
  // own plain text — which is what the server will search. When the rendering
  // and the plain text disagree (a fence, a tree node) we simply do not offer:
  // a note on the whole block is better than an anchor nothing can resolve.
  function anchorable(sel){
    if(!sel || sel.isCollapsed) return null;
    var text = sel.toString().replace(/\s+/g, " ").trim();
    if(text.length < 3) return null;
    var node = sel.anchorNode, el = node && (node.nodeType === 1 ? node : node.parentElement);
    el = el && el.closest && el.closest(".block");
    if(!el) return null;
    // The whole selection has to be in that one block.
    var end = sel.focusNode, endEl = end && (end.nodeType === 1 ? end : end.parentElement);
    if(!endEl || !endEl.closest || endEl.closest(".block") !== el) return null;
    if(el.closest("pre") || isTree) return null;
    var b = blockOf[el.dataset.block];
    if(!b || b.readonly) return null;
    if((b.text || "").replace(/\s+/g, " ").indexOf(text) < 0) return null;
    return {el: el, text: text};
  }
  function offerSelection(){
    var sel = window.getSelection();
    var found = anchorable(sel);
    if(!found){ clearSelOffer(); return; }
    var rect = sel.getRangeAt(0).getBoundingClientRect();
    if(!rect.width && !rect.height){ clearSelOffer(); return; }
    if(!selBtn){
      selBtn = document.createElement("button");
      selBtn.type = "button"; selBtn.className = "selbtn";
      selBtn.textContent = "Comment on selection";
      // mousedown, not click: by the time click fires the selection is gone.
      selBtn.addEventListener("mousedown", function(e){
        e.preventDefault(); e.stopPropagation();
        var f = pending;
        clearSelOffer();
        if(f) openComposer(f.el, null, f.text);
      });
      document.body.appendChild(selBtn);
    }
    pending = found;
    selBtn.style.top  = (window.scrollY + rect.bottom + 6) + "px";
    selBtn.style.left = (window.scrollX + rect.left) + "px";
  }
  document.addEventListener("selectionchange", function(){
    // Debounced to the frame, because selectionchange fires per character
    // while dragging.
    if(offerSelection.queued) return;
    offerSelection.queued = true;
    requestAnimationFrame(function(){ offerSelection.queued = false; offerSelection(); });
  });
  document.addEventListener("scroll", clearSelOffer, true);

  // markSub paints each located sub-anchor onto the rendered block, by walking
  // its text nodes to the offsets the server resolved. Rendering is left
  // alone otherwise: the marks are added after the fact and removed before
  // they are recomputed, so nothing accumulates.
  function markSub(el){
    Array.prototype.forEach.call(el.querySelectorAll("mark.mg-sub"), function(m){
      var parent = m.parentNode;
      while(m.firstChild) parent.insertBefore(m.firstChild, m);
      parent.removeChild(m);
      parent.normalize();
    });
    var list = (byBlock[el.dataset.block] || []).filter(function(n){ return n.at && !n.stale; });
    if(!list.length) return;
    // Later marks first, so painting one does not shift the offsets of the
    // ones before it.
    list.slice().sort(function(a, b){ return b.at.start - a.at.start; }).forEach(function(n){
      paint(el, n.at.start, n.at.end);
    });
  }
  // paint wraps the rune range [start,end) of el's visible text in a <mark>.
  // Offsets are counted the way the server counts them — over whitespace-
  // normalized text — so runs of spaces and newlines in the markup do not
  // shift the answer.
  function paint(el, start, end){
    var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
      acceptNode: function(n){
        // Notes rendered inside the block (a list item's box) are not part of
        // the document's text and must not be counted or marked.
        return n.parentElement && n.parentElement.closest(".existing,.composer,.selbtn")
          ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT;
      }
    });
    var seen = 0, node, first = null, firstOff = 0, last = null, lastOff = 0;
    while((node = walker.nextNode())){
      var raw = node.nodeValue, i = 0;
      while(i < raw.length){
        var isSpace = /\s/.test(raw[i]);
        // Collapse a run of whitespace to the single space the server saw.
        if(isSpace){
          var j = i; while(j < raw.length && /\s/.test(raw[j])) j++;
          if(seen > 0 && seen < end){
            if(seen === start && !first){ first = node; firstOff = i; }
            seen++;
          }
          i = j;
          continue;
        }
        if(seen === start && !first){ first = node; firstOff = i; }
        seen++;
        i++;
        if(seen === end){ last = node; lastOff = i; break; }
      }
      if(last) break;
    }
    if(!first || !last) return;
    try{
      var range = document.createRange();
      range.setStart(first, firstOff);
      range.setEnd(last, lastOff);
      var mark = document.createElement("mark");
      mark.className = "mg-sub";
      mark.dataset.start = String(start);
      range.surroundContents(mark);
    }catch(e){ /* the range crosses an element boundary — leave it unmarked */ }
  }

  // --- the shape of the review -------------------------------------------
  //
  // A sixty-block document is a queue, not a page. These four things make it
  // one: how far through you are, what is left, a way to move between the
  // blocks that still want something, and — when the review demands a verdict
  // on everything — being told what is missing before you press Done rather
  // than by being refused.

  var requireVerdict = !!(data.review && data.review.require_verdict);
  // Commentable is the server's own rule, not a guess: `readonly` in the
  // payload is cfg.Locked(), which is exactly what POST /api/feedback
  // refuses. If those two ever disagree the page is lying about the queue.
  function commentable(b){ return !b.readonly; }
  function answered(id){ return (byBlock[id] || []).length > 0; }
  function askedAbout(b){ return !!(b.notes && b.notes.length); }
  function needsRecheck(id){
    return (byBlock[id] || []).some(function(n){ return (n.status || "outstanding") === "addressed"; });
  }
  // The blocks still wanting a verdict, in document order — what require_verdict
  // is holding Done for.
  function outstandingBlocks(){
    return data.doc.blocks.filter(function(b){ return commentable(b) && !answered(b.id); });
  }
  function progress(){
    var el = document.getElementById("progress");
    var total = data.doc.blocks.filter(commentable).length;
    if(!total){ el.hidden = true; return; }
    var done = data.doc.blocks.filter(function(b){ return commentable(b) && answered(b.id); }).length;
    el.hidden = false;
    document.getElementById("progfill").style.width = Math.round(done/total*100) + "%";
    var text = done + " of " + total + " answered";
    document.getElementById("progtext").textContent = text;
    el.title = text + (requireVerdict ? " — this review asks for a verdict on every one" : "");
  }

  // --- filters ------------------------------------------------------------
  var filterMode = "all";
  function passes(id){
    var b = blockOf[id];
    if(!b) return true;
    switch(filterMode){
      case "unanswered": return commentable(b) && !answered(id);
      case "mine":       return answered(id);
      case "noted":      return askedAbout(b);
      case "recheck":    return needsRecheck(id);
    }
    return true;
  }
  function updateFilterLabel(){
    var sum = document.querySelector("#filter summary");
    if(!sum) return;
    var labels = {all:"Show all", unanswered:"Not answered", mine:"I answered", noted:"Requester asked", recheck:"To re-check"};
    var hiddenN = data.doc.blocks.filter(function(b){ return !b.inline && !passes(b.id); }).length;
    sum.textContent = labels[filterMode] + (filterMode !== "all" ? " (" + hiddenN + " hidden)" : "");
  }
  (function(){
    var box = document.getElementById("filters");
    if(!box) return;
    box.addEventListener("click", function(e){
      var b = e.target.closest("button[data-filter]");
      if(!b) return;
      filterMode = b.dataset.filter;
      Array.prototype.forEach.call(box.querySelectorAll("button"), function(x){
        x.setAttribute("aria-pressed", x.dataset.filter === filterMode ? "true" : "false");
      });
      applyFolds();
      document.getElementById("filter").open = false;
    });
  })();

  // --- movement -----------------------------------------------------------
  //
  // The reviewer works a queue, so the shortcut that matters is "next thing
  // that still wants me". A configured action always wins the key: the agent
  // asked for that vocabulary, and silently stealing its letter would make a
  // documented shortcut stop working. keyHelp() says which ones survived.
  //
  // A configured key is a single character (review.Config enforces that), so
  // anything multi-character cannot be taken: the arrows always work, and the
  // letters are a convenience that yields. Without the arrows the queue
  // shortcut would simply be unavailable on any review that configured `n`,
  // which is a common enough letter that "unanswered" would be the first
  // casualty of a `nit` action.
  var navKeys = {j:"next", k:"prev", n:"nextOpen", p:"prevOpen"};
  function keyFree(k){ return !byKey[k]; }
  // what returns the movement a key event asks for, or "" for none.
  function navFor(e){
    if(e.key === "ArrowDown") return e.shiftKey ? "nextOpen" : "next";
    if(e.key === "ArrowUp")   return e.shiftKey ? "prevOpen" : "prev";
    if(e.shiftKey) return "";
    var what = navKeys[e.key];
    return what && keyFree(e.key) ? what : "";
  }
  function doNav(what){
    move(what === "next" || what === "nextOpen" ? 1 : -1, what === "nextOpen" || what === "prevOpen");
  }
  function visibleBlocks(){
    return data.doc.blocks.filter(function(b){
      var el = elOf[b.id];
      return el && !el.hidden && !el.classList.contains("dimmed");
    });
  }
  function land(el){
    if(!el) return;
    el.scrollIntoView({block:"center", behavior:"smooth"});
    el.classList.remove("landed");
    void el.offsetWidth; // restart the animation even on the same element
    el.classList.add("landed");
    if(el.getAttribute("tabindex") !== null) el.focus({preventScroll:true});
  }
  // move walks from wherever the reviewer is. Wrapping is the point: working
  // a queue means never having to notice you reached the end.
  function move(dir, onlyOpen){
    var list = visibleBlocks();
    if(onlyOpen){
      list = list.filter(function(b){ return commentable(b) && !answered(b.id); });
    }
    if(!list.length){
      toast(onlyOpen ? "Nothing left unanswered." : "Nothing to move to.");
      return;
    }
    var here = document.activeElement && document.activeElement.closest && document.activeElement.closest(".block");
    var at = here ? list.findIndex(function(b){ return b.id === here.dataset.block; }) : -1;
    var next;
    if(at === -1){
      // Not on a block: start from the one nearest the top of the viewport,
      // so the jump follows the eye rather than the DOM.
      var from = list.findIndex(function(b){
        var el = elOf[b.id];
        return el && el.getBoundingClientRect().top > 80;
      });
      next = dir > 0 ? (from === -1 ? 0 : from) : (from <= 0 ? list.length - 1 : from - 1);
    } else {
      next = (at + dir + list.length) % list.length;
    }
    land(elOf[list[next].id]);
  }
  function keyHelp(){
    var names = {next:"next block", prev:"previous block", nextOpen:"next unanswered", prevOpen:"previous unanswered"};
    var lines = ["\u2193/\u2191 — move", "\u21e7\u2193/\u21e7\u2191 — next/previous unanswered"];
    Object.keys(navKeys).forEach(function(k){
      if(keyFree(k)) lines.push(k + " — " + names[navKeys[k]]);
      else lines.push(k + " — taken by " + (byKey[k].label || byKey[k].type));
    });
    toast(lines.join("  \u00b7  "));
  }
  // Typing into anything, or composing a note, owns the keyboard outright.
  function typing(e){
    var t = e.target;
    if(t && (t.tagName === "TEXTAREA" || t.tagName === "INPUT" || t.tagName === "SELECT" || t.isContentEditable)) return true;
    return !!document.querySelector(".composer");
  }
  document.addEventListener("keydown", function(e){
    if(e.metaKey || e.ctrlKey || e.altKey || typing(e)) return;
    if(e.key === "?" && keyFree("?")){ e.preventDefault(); keyHelp(); return; }
    // A focused block has its own handler, and a configured action there beats
    // navigation. It calls doNav itself for what is left over.
    if(e.target && e.target.closest && e.target.closest(".block")) return;
    var what = navFor(e);
    if(!what) return;
    e.preventDefault();
    doNav(what);
  });

  // --- what Done is waiting for -------------------------------------------
  function showOutstanding(){
    var left = outstandingBlocks();
    var panel = document.getElementById("outstanding");
    if(!left.length){ panel.hidden = true; return false; }
    document.getElementById("outstanding-title").textContent =
      left.length + (left.length === 1 ? " block still wants a verdict" : " blocks still want a verdict");
    var list = document.getElementById("outstanding-list");
    list.textContent = "";
    left.forEach(function(b){
      var btn = document.createElement("button");
      btn.type = "button";
      var id = document.createElement("span"); id.className = "id"; id.textContent = b.id;
      btn.appendChild(id);
      btn.appendChild(document.createTextNode(b.quote || b.text || ""));
      btn.addEventListener("click", function(){
        // Jumping to a block the current filter hides would scroll to nothing,
        // so drop back to showing everything first.
        if(!passes(b.id)){
          filterMode = "all";
          Array.prototype.forEach.call(document.querySelectorAll("#filters button"), function(x){
            x.setAttribute("aria-pressed", x.dataset.filter === "all" ? "true" : "false");
          });
          applyFolds();
        }
        land(elOf[b.id]);
      });
      list.appendChild(btn);
    });
    panel.hidden = false;
    panel.scrollIntoView({block:"nearest", behavior:"smooth"});
    return true;
  }
  (function(){
    var close = document.getElementById("outstanding-close");
    if(close) close.onclick = function(){ document.getElementById("outstanding").hidden = true; };
  })();

  // Hovering a note lights the sentence it is about, so a paragraph with
  // three notes is readable rather than a guessing game.
  function lightSub(el, at, on){
    Array.prototype.forEach.call(el.querySelectorAll("mark.mg-sub"), function(m){
      m.classList.toggle("on", on && m.dataset.start === String(at.start));
    });
  }
  var isTree = document.getElementById("doc").classList.contains("tree");
  var elOf = {};

  // Tree documents render as a flat, pre-ordered list of nodes: indentation
  // comes from the node's depth, and a subtree is hidden exactly when its
  // parent is hidden or folded — one pass, no DOM nesting to keep in sync.
  var folded = {};
  // Folding and filtering both hide blocks, so they resolve in one pass: two
  // independent reasons, one `hidden`. Setting it from two places is how a
  // filter and a fold end up fighting over the same element.
  function applyFolds(){
    var hidden = {};
    data.doc.blocks.forEach(function(b){
      var p = b.parent || "";
      var h = !!(p && (hidden[p] || folded[p]));
      hidden[b.id] = h;
      var el = elOf[b.id];
      if(!el) return;
      var shown = passes(b.id);
      // An inline block lives inside its parent's markup, so hiding it would
      // renumber the list around it or tear a hole in the source the author
      // wrote. It stays and dims; only its notes go.
      if(b.inline){
        el.hidden = h;
        el.classList.toggle("dimmed", !shown);
      } else {
        el.hidden = h || !shown;
      }
      var box = el.nextElementSibling;
      while(box && (box.classList.contains("existing") || box.classList.contains("composer"))){
        box.hidden = el.hidden; box = box.nextElementSibling;
      }
    });
    updateFilterLabel();
  }
  function setCaret(el){
    var c = el.querySelector(".caret");
    if(!c || el.dataset.kids !== "1") return;
    var open = !folded[el.dataset.block];
    c.textContent = open ? "\u25be" : "\u25b8";
    c.setAttribute("aria-expanded", open ? "true" : "false");
    c.setAttribute("aria-label", (open ? "Fold " : "Unfold ") + el.dataset.block);
  }
  function decorateTree(el){
    var body = el.firstElementChild;
    var c = document.createElement("button");
    c.type = "button"; c.className = "caret"; c.tabIndex = -1;
    if(el.dataset.kids !== "1"){ c.hidden = true; c.setAttribute("aria-hidden","true"); }
    c.addEventListener("click", function(e){
      e.stopPropagation();
      if(el.dataset.kids !== "1") return;
      var id = el.dataset.block;
      folded[id] = !folded[id];
      setCaret(el); applyFolds();
    });
    el.insertBefore(c, body);
    setCaret(el);
  }

  Array.prototype.forEach.call(document.querySelectorAll(".block"), function(el){
    elOf[el.dataset.block] = el;
    if(isTree) decorateTree(el);
    marker(el); renderExisting(el); markSub(el);
    // A block the agent handed over read-only is context, not a question: it
    // reads normally, keeps any notes already written against it, and opens
    // nothing. The server refuses events for it too — this is the courtesy,
    // that is the enforcement.
    if((blockOf[el.dataset.block]||{}).readonly){
      el.dataset.readonly = "1";
      el.title = "read-only in this review";
      el.removeAttribute("tabindex"); el.removeAttribute("role");
      el.addEventListener("click", function(e){
        if(e.target.closest(".composer,.existing,.caret")) return;
        toast("This block is read-only in this review.");
      });
      return;
    }
    // Blocks nest — a list item sits inside its list, a sub-item inside it —
    // so only the innermost block under the pointer answers.
    el.addEventListener("click", function(e){
      if(e.target.closest(".composer,.existing,.caret")) return;
      if(e.target.closest(".block") !== el) return;
      // Finishing a drag-select is not a click on the block. Without this,
      // selecting a sentence would open a composer about the paragraph and
      // throw the selection away — which is how "comment on a sentence" would
      // have cost "select a sentence".
      var sel = window.getSelection();
      if(sel && !sel.isCollapsed && sel.toString().trim()) return;
      openComposer(el);
    });
    el.addEventListener("keydown", function(e){
      if(e.target !== el || e.metaKey || e.ctrlKey || e.altKey) return;
      if(e.key === "Enter"){ e.preventDefault(); openComposer(el); return; }
      // A configured shortcut: the verdict without the composer. It is
      // checked before movement, so the agent's vocabulary always wins its
      // letter and only what is left over moves the cursor.
      var a = byKey[e.key];
      if(a){
        e.preventDefault();
        if(needsInput(a)) openComposer(el, a); else save(el, a, "", {});
        return;
      }
      var what = navFor(e);
      if(!what) return;
      e.preventDefault();
      doNav(what);
    });
  });
  // A drawn diagram is the review surface and its source is one tap away.
  // Both carry the same anchors, so the reviewer picks the one they think in;
  // the choice sticks, like mode and ligatures, and applies to every diagram
  // on the page at once — flipping them one by one is not a feature.
  (function(){
    var figs = document.querySelectorAll("figure.diagram");
    if(!figs.length) return;
    var key = "marginalia.diagram";
    function wanted(){ try{ return localStorage.getItem(key) === "source"; }catch(e){ return false; } }
    function show(fig, src){
      fig.querySelector(".pic").hidden = src;
      fig.querySelector(".src").hidden = !src;
      var b = fig.querySelector(".flip");
      b.setAttribute("aria-pressed", src ? "true" : "false");
      b.textContent = src ? "Show diagram" : "Show source";
    }
    function showAll(src){
      try{ localStorage.setItem(key, src ? "source" : "picture"); }catch(e){}
      Array.prototype.forEach.call(figs, function(f){ show(f, src); });
    }
    Array.prototype.forEach.call(figs, function(fig){
      show(fig, wanted());
      fig.querySelector(".flip").addEventListener("click", function(e){
        e.stopPropagation();
        showAll(fig.querySelector(".src").hidden);
      });
      // Hovering the invisible click target lights up the shape it stands
      // for — every shape with that anchor, so an edge and the copy that
      // catches its clicks behave as the one thing they are.
      var pic = fig.querySelector(".pic");
      pic.addEventListener("mouseover", function(e){ hover(e.target, true); });
      pic.addEventListener("mouseout", function(e){ hover(e.target, false); });
      // A shape the renderer anchored answers for its statement. The click
      // stops here: the diagram block around it would otherwise claim it and
      // open a composer about the whole picture.
      pic.addEventListener("click", function(e){
        var shape = e.target.closest && e.target.closest("[data-anchor]");
        if(!shape) return;
        var el = elOf[shape.dataset.anchor];
        if(!el) return;
        e.stopPropagation();
        if((blockOf[el.dataset.block]||{}).readonly){ toast("This block is read-only in this review."); return; }
        openComposer(el);
      });
    });
  })();
  var foldBtn = document.getElementById("fold");
  if(foldBtn) foldBtn.onclick = function(){
    var collapse = foldBtn.getAttribute("aria-pressed") !== "true";
    data.doc.blocks.forEach(function(b){
      if(!b.has_children) return;
      folded[b.id] = collapse;
      if(elOf[b.id]) setCaret(elOf[b.id]);
    });
    foldBtn.setAttribute("aria-pressed", collapse ? "true" : "false");
    foldBtn.textContent = collapse ? "Expand all" : "Collapse all";
    applyFolds();
  };
  // The requester's guidance, rendered where it applies. A note whose block
  // is gone is not dropped: it moves to the banner, because a question the
  // agent asked is worth more than tidy markup.
  (function(){
    var stray = [];
    ((data.review && data.review.notes) || []).forEach(function(note){
      var el = elOf[note.block];
      if(!el){ stray.push(note); return; }
      var box = document.createElement("aside");
      box.className = "sidenote";
      var who = document.createElement("span");
      who.className = "who"; who.textContent = "note from the requester";
      box.appendChild(who);
      box.appendChild(document.createTextNode(note.text));
      if(el.tagName === "LI" || el.closest("pre")) attach(el, box); else el.before(box);
    });
    if(!stray.length) return;
    var banner = document.querySelector(".framing") || (function(){
      var s = document.createElement("section"); s.className = "framing";
      document.getElementById("doc").prepend(s);
      return s;
    })();
    var list = document.createElement("div");
    list.className = "unanchored";
    list.textContent = "Notes for blocks this document no longer has: " +
      stray.map(function(n){ return n.block + " — " + n.text; }).join(" · ");
    banner.appendChild(list);
  })();
  // Blocks the requester marked as skipped open collapsed, in runs, so a long
  // document does not ask for attention it does not want.
  (function(){
    var run = [];
    function close(){
      if(!run.length) return;
      var box = document.createElement("details");
      box.className = "skipped";
      var head = document.createElement("summary");
      head.textContent = run.length + (run.length === 1 ? " block" : " blocks") +
        " the requester left out of this review";
      box.appendChild(head);
      run[0].before(box);
      run.forEach(function(el){ box.appendChild(el); });
      run = [];
    }
    data.doc.blocks.forEach(function(b){
      var el = elOf[b.id];
      // An inline block — a list item, a diagram statement — has no element
      // of its own to move; its parent carries it.
      if(!el || el.tagName === "LI" || el.closest("pre")) return;
      if(!b.skipped){ close(); return; }
      // A note the requester left on a skipped block belongs inside the
      // collapsed group with it, not stranded above it.
      var before = el.previousElementSibling;
      if(before && before.classList.contains("sidenote")) run.push(before);
      run.push(el);
      var box = el.nextElementSibling;
      while(box && (box.classList.contains("existing") || box.classList.contains("sidenote"))){
        run.push(box); box = box.nextElementSibling;
      }
    });
    close();
  })();
  // Share mode: replay what this browser remembers, then keep the export in
  // step with it. No Clipboard API anywhere near this — hosted contexts block
  // it — so the textarea is pre-selected and the download is wrapped.
  function refreshShare(){}
  function revealShare(){}
  if(data.static){
    var panel = document.getElementById("share");
    var out = document.getElementById("sharejson");
    var hint = document.getElementById("sharehint");
    refreshShare = function(){
      out.value = JSON.stringify({marginalia: 1, doc: data.doc.path, events: kept}, null, 2);
    };
    revealShare = function(){
      panel.hidden = false;
      refreshShare();
      out.focus(); out.select();
      panel.scrollIntoView({block: "nearest"});
    };
    loadKept();
    kept.forEach(function(ev){
      if(ev.type === "review_done") return;
      var el = elOf[ev.block];
      if(!el) return;
      (byBlock[ev.block] = byBlock[ev.block] || []).push({event: ev, stale: false});
      marker(el); renderExisting(el);
    });
    refreshShare();
    document.getElementById("reveal").onclick = revealShare;
    document.getElementById("download").onclick = function(){
      // Downloads are wrapped: an embedded or sandboxed viewer may refuse
      // them, and the copy path above still works when it does.
      try{
        var url = URL.createObjectURL(new Blob([out.value], {type: "application/json"}));
        var a = document.createElement("a");
        a.href = url; a.download = (data.doc.path.split("/").pop() || "review") + ".feedback.json";
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);
        hint.textContent = "Downloaded.";
      }catch(e){
        hint.textContent = "Download blocked here — copy the text above instead.";
        out.focus(); out.select();
      }
    };
  }
  count();
  progress();
  // Folding is a tree's business, but filtering is every document's, and both
  // resolve here — so this runs for a markdown page too.
  applyFolds();
  // Display settings live in this browser only: a preference about the room
  // the document is read in has no business on the agent's disk.
  (function(){
    var root = document.documentElement;
    function remember(key, value){ try{ localStorage.setItem("marginalia."+key, value); }catch(e){} }
    function mark(box, attr, value){
      Array.prototype.forEach.call(box.querySelectorAll("button"), function(b){
        b.setAttribute("aria-pressed", b.dataset[attr] === value ? "true" : "false");
      });
    }
    var modes = document.getElementById("modes"), ligs = document.getElementById("ligs");
    function syncModes(){ mark(modes, "mode", root.dataset.mode || "system"); }
    function syncLigs(){ mark(ligs, "lig", root.dataset.ligatures === "off" ? "off" : "on"); }
    Array.prototype.forEach.call(modes.querySelectorAll("button"), function(b){
      b.onclick = function(){
        var mode = b.dataset.mode;
        if(mode === "system") delete root.dataset.mode; else root.dataset.mode = mode;
        remember("mode", mode); syncModes();
      };
    });
    Array.prototype.forEach.call(ligs.querySelectorAll("button"), function(b){
      b.onclick = function(){
        if(b.dataset.lig === "off") root.dataset.ligatures = "off"; else delete root.dataset.ligatures;
        remember("ligatures", b.dataset.lig); syncLigs();
      };
    });
    syncModes(); syncLigs();
    // Clicking anywhere else closes the panel, which is what a menu does.
    document.addEventListener("click", function(e){
      var d = document.getElementById("display");
      if(d.open && !e.target.closest("#display")) d.open = false;
    });
  })();
  // Review-set navigation: the sidebar's counts and done ticks are live, so
  // marking a file done shows up without a reload.
  var inSet = !!document.querySelector(".nav");
  function tickOf(link){ return link && link.parentElement.querySelector(".tick"); }
  function refreshSetCount(){
    var el = document.getElementById("setcount");
    if(!el) return;
    var total = document.querySelectorAll(".nav a[data-nav]").length, done = 0;
    Array.prototype.forEach.call(document.querySelectorAll(".nav .tick"), function(t){ if(!t.hidden) done++; });
    el.textContent = total + " documents · " + done + " done";
  }
  function bumpCurrentCount(){
    var badge = document.querySelector('.nav a[aria-current="page"]');
    badge = badge && badge.parentElement.querySelector(".n");
    if(!badge) return;
    badge.textContent = String((parseInt(badge.textContent, 10) || 0) + 1);
    badge.hidden = false;
  }
  document.getElementById("done").onclick=function(){
    // Say what is missing before asking the server to refuse. Learning the
    // rule by being told no, with a number and no names, is how a reviewer
    // ends up hunting badges down a sixty-block page.
    if(requireVerdict && showOutstanding()){
      toast("Some blocks still want a verdict.");
      return;
    }
    document.getElementById("outstanding").hidden = true;
    if(data.static){
      keep({doc:data.doc.path,block:"",quote:"",hash:"",type:"review_done",text:"",author:author});
      revealShare();
      toast("Marked done — now send it back with Export.");
      return;
    }
    fetch("/api/feedback",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({doc:data.doc.path,type:"review_done",text:"",author:author})})
      .then(function(res){ if(!res.ok) return res.text().then(function(t){
          // The page renders the rule; the server enforces it. If they ever
          // disagree the server is right, so show its refusal and the list.
          if(res.status === 409) showOutstanding();
          throw new Error(t.trim());
        });
        var t = tickOf(document.querySelector('.nav a[aria-current="page"]'));
        if(t) t.hidden = false;
        refreshSetCount();
        toast(inSet ? "This file is marked done." : "Review marked done — you can close this tab."); })
      .catch(function(err){ toast(err.message || "Failed"); });
  };
  // --watch: the server re-parses when the file changes, so the page checks
  // whether the render it is showing has been outrun. It never reloads under
  // the reviewer's hands — a re-render that discards a half-typed comment is
  // worse than a stale page — so an open composer turns this into a prompt.
  if(data.watch){
    // The baseline is the revision this page was rendered from, not whatever
    // the first poll happens to see — a change landing before that first poll
    // would otherwise be adopted as normal and never reported.
    var startRev = data.revision;
    var reloader = document.getElementById("reloader");
    document.getElementById("reload").onclick = function(){ location.reload(); };
    setInterval(function(){
      fetch("/api/revision", {cache: "no-store"})
        .then(function(res){ return res.ok ? res.json() : null; })
        .then(function(state){
          if(!state || state.rev === startRev) return;
          if(document.querySelector(".composer")) { reloader.hidden = false; return; }
          location.reload();
        })
        .catch(function(){ /* the server went away; the page is still readable */ });
    }, 2000);
  }

  var finish = document.getElementById("finish");
  if(finish) finish.onclick=function(){
    fetch("/api/session_done",{method:"POST"})
      .then(function(res){ if(!res.ok) return res.text().then(function(t){throw new Error(t);}); return res.json(); })
      .then(function(){
        Array.prototype.forEach.call(document.querySelectorAll(".nav .tick"), function(t){ t.hidden = false; });
        refreshSetCount();
        finish.textContent = "Finish review set \u2713";
        toast("Review set marked done — you can close this tab."); })
      .catch(function(err){ toast(err.message || "Failed"); });
  };
})();
</script>
</body>
</html>

{{define "navlist"}}<ul>
  {{range .}}<li>
    {{if .Dir}}<span class="dir">{{.Label}}/</span>{{template "navlist" .Children}}
    {{else}}<a href="{{.URL}}" data-nav="{{.URL}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a><span class="n"{{if not .Count}} hidden{{end}}>{{.Count}}</span><span class="tick"{{if not .Done}} hidden{{end}} title="Marked done">✓</span>{{end}}
  </li>{{end}}
</ul>{{end}}
