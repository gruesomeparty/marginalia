# Your instance's settings. Copy this file to settings.env (ignored by git),
# fill it in, and deploy with --secrets-file settings.env: every line becomes
# an encrypted Worker secret, and the Worker hands each MARGINALIA_* one to
# the container. Never commit the filled-in copy.

# --- Required ---------------------------------------------------------------

# The origin reviewers and agents reach the instance at: every link the host
# hands out is built from it. The same hostname you pass to --domain.
MARGINALIA_PUBLIC_URL=https://review.example.com

# Where every review lives. A container's disk does not outlive it, so this
# has to be R2: the bucket, and optionally a prefix inside it.
MARGINALIA_STORE=r2://marginalia-reviews/prod
MARGINALIA_R2_ACCOUNT_ID=
MARGINALIA_R2_ACCESS_KEY_ID=
MARGINALIA_R2_SECRET_ACCESS_KEY=

# The reviewer: Cloudflare Access's JWT on every page request. The team
# domain, and the AUD tag of the Access application on the hostname.
MARGINALIA_HUMAN_JWT_ISSUER=https://your-team.cloudflareaccess.com
MARGINALIA_HUMAN_JWT_AUDIENCE=

# Agents on /mcp: a bearer token (openssl rand -hex 32), an OAuth
# authorization server, or both. With neither the host refuses to start.
MARGINALIA_MCP_TOKEN=

# --- Optional ---------------------------------------------------------------

# The claude.ai connector: an Access for SaaS (OIDC) application's issuer.
# docs/hosting.md, "Agents: /mcp as an OAuth resource server".
# MARGINALIA_MCP_OAUTH_ISSUER=https://your-team.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client-id>

# A push when an agent publishes, or replies after you finished: an ntfy
# topic or a webhook. Titles and counts only, never a word of a document.
# MARGINALIA_NOTIFY_URL=https://ntfy.sh/<your-topic>

# What agents holding the static token write as (default: agent).
# MARGINALIA_AGENT_NAME=agent

# Caps and retention; the README lists the defaults.
# MARGINALIA_LIMIT_OPEN_REVIEWS=
# MARGINALIA_LIMIT_STORED_BYTES=
# MARGINALIA_RETAIN_DONE=720h
# MARGINALIA_RETAIN_OPEN=2160h
