// marginalia host on Cloudflare: one Worker in front of one Container.
//
// Nothing here names an account, a domain or a credential, and nothing
// should: the hostname goes on the command line (`--domain`), every
// MARGINALIA_* setting into a secrets file you keep outside this repo
// (`--secrets-file`). README.md has the whole procedure.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marginalia",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // The custom domain given at deploy is the only way in. A workers.dev
  // address or a preview URL would be a second hostname that Cloudflare
  // Access does not sit in front of.
  "workers_dev": false,
  "preview_urls": false,

  "containers": [
    {
      "class_name": "Marginalia",
      // The Durable Object starts the container itself, naming the image and
      // the instance size (src/index.ts). Cloudflare refuses the "default"
      // policy on some accounts, and a policy is immutable once deployed.
      // There is no max_instances: there is one container because the
      // Worker only ever asks for one Durable Object, and the host is its
      // store's single writer — keep it that way.
      "scheduling_policy": "durable_object",
      "images": {
        // A one-line Dockerfile naming the released image; wrangler builds
        // it and pushes it to Cloudflare's registry.
        "marginalia": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MARGINALIA", "class_name": "Marginalia" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Marginalia"] }],

  "observability": { "enabled": true }
}
